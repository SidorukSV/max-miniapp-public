
&НаКлиенте
Процедура ЗаполнитьИнформациюОБоте(Команда)
	ЗаполнитьИнформациюОБотеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРассылкиЗаписей(Команда)

	Если Объект.Канал <> ПредопределенноеЗначение("Перечисление.бит_омни_КаналыСвязи.MAX") Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите канал MAX.'"));
		Возврат;
	КонецЕсли;

	Если Не Объект.Использовать Тогда
		ПоказатьПредупреждение(, НСтр("ru='Включите флаг Использовать.'"));
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Объект.Токен) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Укажите токен MAX.'"));
		Возврат;
	КонецЕсли;

	Попытка
		Записать();
		//+бит_Сафаров ШИ 19.08.2026
		Анализ = ПроанализироватьРассылкиЗаписейНаСервере();
		Если Анализ.Готово Тогда
			ПоказатьОповещениеПользователя(
				НСтр("ru='Три стандартные рассылки MAX уже настроены и активны.'"));
			Возврат;
		КонецЕсли;

		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("REPAIR", НСтр("ru='Скорректировать существующие'"));
		Кнопки.Добавить("RECREATE", НСтр("ru='Создать новые и отключить старые'"));
		Кнопки.Добавить("CANCEL", НСтр("ru='Отмена'"));

		ДополнительныеПараметры = Новый Структура("Сигнатура", Анализ.Сигнатура);
		Оповещение = Новый ОписаниеОповещения(
			"СоздатьРассылкиЗаписейПослеВыбораДействия",
			ЭтотОбъект,
			ДополнительныеПараметры);
		ТекстВопроса = Анализ.ТекстПредпросмотра
			+ Символы.ПС + Символы.ПС
			+ НСтр("ru='Старые объекты не удаляются. Во втором варианте отключается только их связь с текущим ботом.'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки);
		//-бит_Сафаров ШИ 19.08.2026
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

//+бит_Сафаров ШИ 19.08.2026
&НаКлиенте
Процедура СоздатьРассылкиЗаписейПослеВыбораДействия(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если РезультатВыбора = Неопределено Или РезультатВыбора = "CANCEL" Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Результат = СоздатьРассылкиЗаписейНаСервере(
			РезультатВыбора,
			ДополнительныеПараметры.Сигнатура);
		ПоказатьОповещениеПользователя(СтрШаблон(
			НСтр("ru='Готово. Создано: %1, исправлено: %2, активировано: %3, отключено старых: %4, пропущено: %5.'"),
			Результат.Создано,
			Результат.Исправлено,
			Результат.Активировано,
			Результат.Деактивировано,
			Результат.Пропущено));
		Если Результат.Предупреждения.Количество() > 0 Тогда
			ПоказатьПредупреждение(, СтрСоединить(Результат.Предупреждения, Символы.ПС));
		КонецЕсли;
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ПроанализироватьРассылкиЗаписейНаСервере()

	Возврат Справочники.бит_омни_Рассылки.ПроанализироватьСтандартныеРассылкиЗаписейMAX(Объект.Ссылка);

КонецФункции

&НаСервере
Функция СоздатьРассылкиЗаписейНаСервере(Режим, Сигнатура)

	Возврат Справочники.бит_омни_Рассылки.ПрименитьСтандартныеРассылкиЗаписейMAX(
		Объект.Ссылка,
		Режим,
		Сигнатура);

КонецФункции

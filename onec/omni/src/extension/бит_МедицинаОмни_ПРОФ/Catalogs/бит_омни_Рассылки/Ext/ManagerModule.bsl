Функция бит_омни_ОписаниеСтандартногоСценария(
	Идентификатор, Представление, Наименование, ИдентификаторШаблона, РежимРассылки, ЭтоНапоминание)

	ИдентификаторыКандидатов = Новый Массив;
	ИдентификаторыКандидатов.Добавить(ИдентификаторШаблона);
	ИменаКандидатов = Новый Массив;
	ИменаКандидатов.Добавить(Наименование);

	Если Идентификатор = "MAX_APPOINTMENT_CONFIRM_REQUEST" Тогда
		ИменаКандидатов.Добавить("MAX: запрос подтверждения записи");
	ИначеЕсли Идентификатор = "MAX_APPOINTMENT_CREATED" Тогда
		ИменаКандидатов.Добавить("MAX: создана запись");

	ИначеЕсли Идентификатор = "MAX_APPOINTMENT_REMINDER" Тогда
		ИменаКандидатов.Добавить("MAX: напоминание о записи");
	КонецЕсли;

	Возврат Новый Структура(
		"Идентификатор, Представление, Наименование, ИдентификаторШаблона, РежимРассылки, ЭтоНапоминание, ИдентификаторыКандидатов, ИменаКандидатов",
		Идентификатор,
		Представление,
		Наименование,
		ИдентификаторШаблона,
		РежимРассылки,
		ЭтоНапоминание,
		ИдентификаторыКандидатов,
		ИменаКандидатов);

КонецФункции

Функция бит_омни_ПроанализироватьСценарий(Бот, ОписаниеСценария)

	ТекущаяРассылка = бит_омни_РассылкаИзСопоставления(Бот, ОписаниеСценария.Идентификатор);
	Кандидаты = бит_омни_КандидатыРассылки(ОписаниеСценария);
	Если ЗначениеЗаполнено(ТекущаяРассылка) И Кандидаты.Найти(ТекущаяРассылка) = Неопределено Тогда
		Кандидаты.Добавить(ТекущаяРассылка);
	КонецЕсли;

	КоличествоШаблонов = бит_омни_КоличествоСтандартныхШаблонов(
		ОписаниеСценария.ИдентификаторШаблона);
	Активна = ЗначениеЗаполнено(ТекущаяРассылка)
		И бит_омни_РассылкаАктивнаДляБота(ТекущаяРассылка, Бот);
	ОбщаяДляДругихБотов = ЗначениеЗаполнено(ТекущаяРассылка)
		И бит_омни_РассылкаИспользуетсяДругимиБотами(ТекущаяРассылка, Бот);

	Если КоличествоШаблонов > 1 Тогда
		Статус = "CONFLICT";
		Описание = "Найдено несколько стандартных шаблонов с одинаковым идентификатором.";
	ИначеЕсли ЗначениеЗаполнено(ТекущаяРассылка) Тогда
		Если бит_омни_РассылкаСоответствуетСценарию(ТекущаяРассылка, ОписаниеСценария)
			И Активна Тогда
			Статус = "READY";
			Описание = "Настроена и активна.";
		ИначеЕсли ОбщаяДляДругихБотов Тогда
			Статус = "SHARED";
			Описание = "Рассылка изменена или неактивна и используется другими ботами.";
		Иначе
			Статус = "NEEDS_REPAIR";
			Описание = "Управляемая рассылка требует корректировки или активации.";
		КонецЕсли;
	ИначеЕсли Кандидаты.Количество() = 0 Тогда
		Статус = "MISSING";
		Описание = "Рассылка отсутствует.";
	ИначеЕсли Кандидаты.Количество() > 1 Тогда
		Статус = "DUPLICATES";
		Описание = "Найдено несколько подходящих существующих рассылок.";
	Иначе
		ТекущаяРассылка = Кандидаты[0];
		Активна = бит_омни_РассылкаАктивнаДляБота(ТекущаяРассылка, Бот);
		ОбщаяДляДругихБотов = бит_омни_РассылкаИспользуетсяДругимиБотами(ТекущаяРассылка, Бот);
		Статус = ?(ОбщаяДляДругихБотов, "SHARED", "LEGACY");
		Описание = ?(
			ОбщаяДляДругихБотов,
			"Найдена старая рассылка, используемая другими ботами.",
			"Найдена старая рассылка без служебного сопоставления.");
	КонецЕсли;

	Возврат Новый Структура(
		"Идентификатор, Представление, Статус, Описание, ТекущаяРассылка, Кандидаты, Активна, ИспользуетсяДругимиБотами, Наименование, ИдентификаторШаблона, РежимРассылки, ЭтоНапоминание",
		ОписаниеСценария.Идентификатор,
		ОписаниеСценария.Представление,
		Статус,
		Описание,
		ТекущаяРассылка,
		Кандидаты,
		Активна,
		ОбщаяДляДругихБотов,
		ОписаниеСценария.Наименование,
		ОписаниеСценария.ИдентификаторШаблона,
		ОписаниеСценария.РежимРассылки,
		ОписаниеСценария.ЭтоНапоминание);

КонецФункции

Функция бит_омни_РассылкаИзСопоставления(Бот, ИдентификаторСценария)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	СтандартныеРассылки.Рассылка КАК Рассылка
	|ИЗ
	|	РегистрСведений.бит_омни_СтандартныеРассылкиMAX КАК СтандартныеРассылки
	|ГДЕ
	|	СтандартныеРассылки.Бот = &Бот
	|	И СтандартныеРассылки.ИдентификаторСценария = &ИдентификаторСценария";
	Запрос.УстановитьПараметр("Бот", Бот);
	Запрос.УстановитьПараметр("ИдентификаторСценария", ИдентификаторСценария);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Рассылка;
	КонецЕсли;
	Возврат Справочники.бит_омни_Рассылки.ПустаяСсылка();

КонецФункции

Функция бит_омни_КандидатыРассылки(ОписаниеСценария)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Рассылки.Ссылка КАК Рассылка
	|ИЗ
	|	Справочник.бит_омни_Рассылки КАК Рассылки
	|ГДЕ
	|	Рассылки.Шаблон.ИдентификаторСтандартногоШаблона В(&ИдентификаторыШаблонов)
	|	ИЛИ Рассылки.Наименование В(&ИменаРассылок)";
	Запрос.УстановитьПараметр("ИдентификаторыШаблонов", ОписаниеСценария.ИдентификаторыКандидатов);
	Запрос.УстановитьПараметр("ИменаРассылок", ОписаниеСценария.ИменаКандидатов);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Рассылка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция бит_омни_КоличествоСтандартныхШаблонов(ИдентификаторШаблона)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Шаблоны.Ссылка) КАК Количество
	|ИЗ
	|	Справочник.бит_омни_ШаблоныСообщений КАК Шаблоны
	|ГДЕ
	|	Шаблоны.ИдентификаторСтандартногоШаблона = &Идентификатор
	|	И НЕ Шаблоны.ПометкаУдаления";
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторШаблона);
	Возврат Запрос.Выполнить().Выгрузить()[0].Количество;

КонецФункции

Функция бит_омни_РассылкаСоответствуетСценарию(Рассылка, ОписаниеСценария)

	Если Рассылка.ПометкаУдаления
		Или Рассылка.РежимРассылки <> ОписаниеСценария.РежимРассылки
		Или Рассылка.Шаблон.ИдентификаторСтандартногоШаблона <> ОписаниеСценария.ИдентификаторШаблона Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не СхемаСоответствуетСтандартуMAX(Рассылка.СКДКонтекст, Истина)
		Или Не СхемаСоответствуетСтандартуMAX(Рассылка.СКДПолучатели, Ложь) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ОписаниеСценария.ЭтоНапоминание Тогда
		Попытка
			Возврат ТипЗнч(Рассылка.Расписание.Получить()) = Тип("РасписаниеРегламентногоЗадания");
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;

	Возврат бит_омни_ЕстьПринадлежностьЗаявке(Рассылка);

КонецФункции

Функция бит_омни_ЕстьПринадлежностьЗаявке(Рассылка)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Принадлежность.Ссылка КАК Рассылка
	|ИЗ
	|	Справочник.бит_омни_Рассылки.Принадлежность КАК Принадлежность
	|ГДЕ
	|	Принадлежность.Ссылка = &Рассылка
	|	И Принадлежность.Объект = &Объект";
	Запрос.УстановитьПараметр("Рассылка", Рассылка);
	Запрос.УстановитьПараметр("Объект", "Документ.Заявка");
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция бит_омни_РассылкаАктивнаДляБота(Рассылка, Бот)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	АктивныеРассылки.Рассылка КАК Рассылка
	|ИЗ
	|	РегистрСведений.бит_омни_АктивныеРассылки КАК АктивныеРассылки
	|ГДЕ
	|	АктивныеРассылки.Рассылка = &Рассылка
	|	И АктивныеРассылки.Бот = &Бот";
	Запрос.УстановитьПараметр("Рассылка", Рассылка);
	Запрос.УстановитьПараметр("Бот", Бот);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция бит_омни_РассылкаИспользуетсяДругимиБотами(Рассылка, Бот)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	АктивныеРассылки.Бот КАК Бот
	|ИЗ
	|	РегистрСведений.бит_омни_АктивныеРассылки КАК АктивныеРассылки
	|ГДЕ
	|	АктивныеРассылки.Рассылка = &Рассылка
	|	И АктивныеРассылки.Бот <> &Бот";
	Запрос.УстановитьПараметр("Рассылка", Рассылка);
	Запрос.УстановитьПараметр("Бот", Бот);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция бит_омни_СигнатураАнализа(Бот, Сценарии)

	Строки = Новый Массив;
	Строки.Добавить(Строка(Бот));
	Для Каждого Сценарий Из Сценарии Цикл
		Строки.Добавить(СтрШаблон(
			"%1|%2|%3|%4|%5",
			Сценарий.Идентификатор,
			Сценарий.Статус,
			Строка(Сценарий.ТекущаяРассылка),
			Сценарий.Кандидаты.Количество(),
			Сценарий.Активна));
	КонецЦикла;

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(СтрСоединить(Строки, Символы.ПС));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

Процедура бит_омни_ПрименитьСценарий(Бот, Сценарий, Режим, Результат)

	Если Сценарий.Статус = "READY" Тогда
		Результат.Пропущено = Результат.Пропущено + 1;
		Возврат;
	КонецЕсли;

	Если бит_омни_КоличествоСтандартныхШаблонов(Сценарий.ИдентификаторШаблона) <> 1 Тогда
		Результат.Пропущено = Результат.Пропущено + 1;
		Результат.Предупреждения.Добавить(СтрШаблон(
			"%1: стандартный шаблон отсутствует или имеет дубли.",
			Сценарий.Представление));
		Возврат;
	КонецЕсли;

	СоздатьНовую = Режим = "RECREATE"
		Или Не ЗначениеЗаполнено(Сценарий.ТекущаяРассылка)
		Или Сценарий.Статус = "DUPLICATES"
		Или Сценарий.Статус = "CONFLICT";

	Если Режим = "REPAIR" И Сценарий.ИспользуетсяДругимиБотами Тогда
		Результат.Пропущено = Результат.Пропущено + 1;
		Результат.Предупреждения.Добавить(СтрШаблон(
			"%1: существующая рассылка используется другими ботами; выберите создание новых.",
			Сценарий.Представление));
		Возврат;
	КонецЕсли;

	Если СоздатьНовую Тогда
		ОбъектРассылки = СоздатьЭлемент();
		Результат.Создано = Результат.Создано + 1;
	Иначе
		ОбъектРассылки = Сценарий.ТекущаяРассылка.ПолучитьОбъект();
		Результат.Исправлено = Результат.Исправлено + 1;
	КонецЕсли;

	ОбъектРассылки.Наименование = Сценарий.Наименование;
	ОбъектРассылки.Шаблон = Справочники.бит_омни_ШаблоныСообщений.СтандартныйШаблон(
		Сценарий.ИдентификаторШаблона);
	ОбъектРассылки.РежимРассылки = Сценарий.РежимРассылки;
	// Управляемая очередь определяет момент отправки, поэтому схемы содержат
	// контекст заявки и клиента без отбора только новых записей.
	ОбъектРассылки.СКДКонтекст = Новый ХранилищеЗначения(СхемаСтандартнойРассылкиMAX(Истина));
	ОбъектРассылки.СКДПолучатели = Новый ХранилищеЗначения(СхемаСтандартнойРассылкиMAX(Ложь));

	ОбъектРассылки.Принадлежность.Очистить();
	Если Сценарий.ЭтоНапоминание Тогда
		ОбъектРассылки.Расписание = Новый ХранилищеЗначения(бит_омни_РасписаниеНапоминаний());
	Иначе
		СтрокаПринадлежности = ОбъектРассылки.Принадлежность.Добавить();
		СтрокаПринадлежности.Объект = "Документ.Заявка";
	КонецЕсли;
	ОбъектРассылки.Записать();
	Рассылка = ОбъектРассылки.Ссылка;

	Если АктивироватьРассылкуЕслиНужно(Рассылка, Бот) Тогда
		Результат.Активировано = Результат.Активировано + 1;
	КонецЕсли;

	ЗаписьСопоставления = РегистрыСведений.бит_омни_СтандартныеРассылкиMAX.СоздатьМенеджерЗаписи();
	ЗаписьСопоставления.Бот = Бот;
	ЗаписьСопоставления.ИдентификаторСценария = Сценарий.Идентификатор;
	ЗаписьСопоставления.Рассылка = Рассылка;
	ЗаписьСопоставления.ВерсияСтандарта = 1;
	ЗаписьСопоставления.ОтпечатокНастроек = бит_омни_ОтпечатокРассылки(Рассылка, Сценарий.Идентификатор);
	ЗаписьСопоставления.Записать();

	Если Режим = "RECREATE" Тогда
		Для Каждого СтараяРассылка Из Сценарий.Кандидаты Цикл
			Если СтараяРассылка = Рассылка Тогда
				Продолжить;
			КонецЕсли;
			Если бит_омни_ДеактивироватьРассылку(СтараяРассылка, Бот) Тогда
				Результат.Деактивировано = Результат.Деактивировано + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Возвращает отдельную схему управляемых стандартных рассылок.
// Старые схемы новых записей сохраняются для пользовательских рассылок.
Функция СхемаСтандартнойРассылкиMAX(ЭтоКонтекст)

	Наименование = ?(ЭтоКонтекст,
		"MAX: контекст управляемых рассылок записей",
		"MAX: получатели управляемых рассылок записей");
	СсылкаСКД = Справочники.бит_омни_СхемыКомпоновкиДанных.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(СсылкаСКД) Тогда
		Если Не СсылкаСКД.ПометкаУдаления И СхемаСоответствуетСтандартуMAX(СсылкаСКД, ЭтоКонтекст) Тогда
			Возврат СсылкаСКД;
		КонецЕсли;
		ОбъектСКД = СсылкаСКД.ПолучитьОбъект();
	Иначе
		ОбъектСКД = Справочники.бит_омни_СхемыКомпоновкиДанных.СоздатьЭлемент();
	КонецЕсли;

	Если ЭтоКонтекст Тогда
		Схема = СоздатьСКДКонтекстаЗаписи();
	Иначе
		Схема = СоздатьСКДПолучателейЗаписи(Ложь);
	КонецЕсли;
	Схема.НастройкиПоУмолчанию.Отбор.Элементы.Очистить();
	Для Каждого ВыбранноеПоле Из Схема.НастройкиПоУмолчанию.Выбор.Элементы Цикл
		ВыбранноеПоле.Использование = Истина;
	КонецЦикла;
	ОбъектСКД.Наименование = Наименование;
	ОбъектСКД.ПометкаУдаления = Ложь;
	ОбъектСКД.ХранилищеСКД = Новый ХранилищеЗначения(Схема, Новый СжатиеДанных(9));
	ОбъектСКД.Записать();
	Возврат ОбъектСКД.Ссылка;

КонецФункции

// Отсутствующая, нечитаемая или оставшаяся от старого сценария новой записи
// схема не позволяет считать управляемую рассылку настроенной.
Функция СхемаСоответствуетСтандартуMAX(ЗначениеСхемы, ЭтоКонтекст)

	Схема = бит_омни_ОбщегоНазначения.СхемаКомпоновкиРассылки(ЗначениеСхемы);
	Если Схема = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Схема.НастройкиПоУмолчанию.Отбор.Элементы.Количество() > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	НаборДанных = Схема.НаборыДанных.Найти("НаборДанныхОбъединенный");
	Если ТипЗнч(НаборДанных) <> Тип("НаборДанныхОбъектСхемыКомпоновкиДанных") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЭтоКонтекст Тогда
		Если Схема.НаборыДанных.Найти("ПередЗаписью") = Неопределено
			Или Схема.НаборыДанных.Найти("ПриЗаписи") = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		ОжидаемыеПоля = Новый Структура(
			"appointment_id, appointment_date, appointment_time, doctor, address",
			"СсылкаПосле", "ДатаНачалаПосле", "ДатаНачалаПосле", "СотрудникПосле", "ФилиалПосле");
	Иначе
		ОжидаемыеПоля = Новый Структура("Получатель", "КлиентПосле");
	КонецЕсли;
	ОжидаемыеВыбранныеПоля = Новый Соответствие;
	Для Каждого ОжидаемоеПоле Из ОжидаемыеПоля Цикл
		ОжидаемыеВыбранныеПоля.Вставить(ОжидаемоеПоле.Ключ, Истина);
	КонецЦикла;
	Для Каждого Поле Из НаборДанных.Поля Цикл
		Если ТипЗнч(Поле) <> Тип("ПолеНабораДанныхСхемыКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		ПутьКДанным = Неопределено;
		Если ОжидаемыеПоля.Свойство(Поле.ПутьКДанным, ПутьКДанным) И Поле.Поле = ПутьКДанным Тогда
			ОжидаемыеПоля.Удалить(Поле.ПутьКДанным);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ВыбранноеПоле Из Схема.НастройкиПоУмолчанию.Выбор.Элементы Цикл
		Если ТипЗнч(ВыбранноеПоле) = Тип("ВыбранноеПолеКомпоновкиДанных") И ВыбранноеПоле.Использование Тогда
			ОжидаемыеВыбранныеПоля.Удалить(Строка(ВыбранноеПоле.Поле));
		КонецЕсли;
	КонецЦикла;
	Возврат ОжидаемыеПоля.Количество() = 0 И ОжидаемыеВыбранныеПоля.Количество() = 0;

КонецФункции

Функция бит_омни_РасписаниеНапоминаний()

	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ДатаНачала = ТекущаяДатаСеанса();
	Расписание.ПериодПовтораДней = 1;
	Расписание.ПериодПовтораВТечениеДня = 300;
	Для НомерДня = 1 По 7 Цикл
		Расписание.ДниНедели.Добавить(НомерДня);
	КонецЦикла;
	Возврат Расписание;

КонецФункции

Функция бит_омни_ДеактивироватьРассылку(Рассылка, Бот)

	Если Не бит_омни_РассылкаАктивнаДляБота(Рассылка, Бот) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запись = РегистрыСведений.бит_омни_АктивныеРассылки.СоздатьМенеджерЗаписи();
	Запись.Рассылка = Рассылка;
	Запись.Бот = Бот;
	Запись.Удалить();
	Возврат Истина;

КонецФункции

Функция бит_омни_ОтпечатокРассылки(Рассылка, ИдентификаторСценария)

	Данные = СтрШаблон(
		"%1|%2|%3|%4|%5",
		ИдентификаторСценария,
		Рассылка.Шаблон.ИдентификаторСтандартногоШаблона,
		Строка(Рассылка.РежимРассылки),
		бит_омни_ЕстьПринадлежностьЗаявке(Рассылка),
		Рассылка.ПометкаУдаления);
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

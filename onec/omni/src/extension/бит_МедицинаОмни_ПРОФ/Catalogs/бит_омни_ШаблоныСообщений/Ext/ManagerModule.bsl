КонецФункции

Функция ЗагрузитьСтандартныеШаблоны(Идентификаторы) Экспорт

	Если ТипЗнч(Идентификаторы) <> Тип("Массив") Или Идентификаторы.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	КоличествоЗагруженных = 0;
	Для Каждого ОписаниеШаблона Из СтандартныеШаблоны() Цикл

		Если Идентификаторы.Найти(ОписаниеШаблона.Идентификатор) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СсылкаШаблона = СтандартныйШаблон(ОписаниеШаблона.Идентификатор);
		Если СсылкаШаблона.Пустая() Тогда
			ОбъектШаблона = СоздатьЭлемент();
		Иначе
			ОбъектШаблона = СсылкаШаблона.ПолучитьОбъект();
		КонецЕсли;

		ОбъектШаблона.Наименование = ОписаниеШаблона.Наименование;
		ОбъектШаблона.ИдентификаторСтандартногоШаблона = ОписаниеШаблона.Идентификатор;
		ОбъектШаблона.ШаблонСообщения = ОписаниеШаблона.Текст;
		ОбъектШаблона.ВариантФормата = ОписаниеШаблона.Формат;
		ОбъектШаблона.КнопкиMAX = ОписаниеШаблона.Кнопки;
		ОбъектШаблона.ПоляШаблона.Очистить();

		Для Каждого ОписаниеПоля Из ОписаниеШаблона.Поля Цикл
			СтрокаПоля = ОбъектШаблона.ПоляШаблона.Добавить();
			СтрокаПоля.Поле = ОписаниеПоля.Поле;
			СтрокаПоля.АлгоритмРасчета = ОписаниеПоля.АлгоритмРасчета;
		КонецЦикла;

		ОбъектШаблона.Записать();
		КоличествоЗагруженных = КоличествоЗагруженных + 1;

	КонецЦикла;

	Возврат КоличествоЗагруженных;

КонецФункции

Функция ЗначениеПоляКонтекста(Контекст, ИмяПоля) Экспорт

	Если Контекст = Неопределено Или Контекст = Null Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Контекст.Свойство(ИмяПоля, Значение) Тогда
			Возврат СтроковоеЗначение(Значение);
		КонецЕсли;

		Для Каждого Псевдоним Из ПсевдонимыПоля(ИмяПоля) Цикл
			Если Контекст.Свойство(Псевдоним, Значение) Тогда
				Возврат СтроковоеЗначение(Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если ИмяПоля = "appointment_id" Или ИмяПоля = "survey_id" Тогда
		Попытка
			Возврат Строка(Контекст.УникальныйИдентификатор());
		Исключение
			Возврат "";
		КонецПопытки;
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьЗначениеПоШаблону(ИсходноеЗначение, Шаблон, Получатель, Контекст)

	РезультирующаяСтрока = ИсходноеЗначение;
	НачалоБлока = ?(НРег(Шаблон.ВариантФормата) = "html", "{{ ", "<");
	КонецБлока = ?(НРег(Шаблон.ВариантФормата) = "html", " }}", ">");

	Для Каждого ПолеШаблона Из Шаблон.ПоляШаблона Цикл
		Поле = НачалоБлока + ПолеШаблона.Поле + КонецБлока;
		Результат = "";
		Выполнить(ПолеШаблона.АлгоритмРасчета);
		РезультирующаяСтрока = СтрЗаменить(РезультирующаяСтрока, Поле, СтроковоеЗначение(Результат));
	КонецЦикла;

	Возврат РезультирующаяСтрока;

КонецФункции

Процедура ДобавитьСтандартныйШаблон(
	Шаблоны, Идентификатор, Наименование, Текст, Формат, Кнопки, Поля)

	Шаблоны.Добавить(Новый Структура(
		"Идентификатор, Наименование, Текст, Формат, Кнопки, Поля, УжеЗагружен",
		Идентификатор, Наименование, Текст, Формат, Кнопки, Поля, Ложь));

КонецПроцедуры

Функция ПоляЗаписи()

	Поля = Новый Массив;
	Поля.Добавить(ПолеШаблона(
		"ИдентификаторЗаписи", "Результат = ЗначениеПоляКонтекста(Контекст, ""appointment_id"");"));
	Поля.Добавить(ПолеШаблона(
		"ДатаЗаписи", "Результат = ЗначениеПоляКонтекста(Контекст, ""appointment_date"");"));
	Поля.Добавить(ПолеШаблона(
		"ВремяЗаписи", "Результат = ЗначениеПоляКонтекста(Контекст, ""appointment_time"");"));
	Поля.Добавить(ПолеШаблона(
		"Врач", "Результат = ЗначениеПоляКонтекста(Контекст, ""doctor"");"));
	Поля.Добавить(ПолеШаблона(
		"Адрес", "Результат = ЗначениеПоляКонтекста(Контекст, ""address"");"));
	Возврат Поля;

КонецФункции

Функция ПолеШаблона(Поле, АлгоритмРасчета)

	Возврат Новый Структура("Поле, АлгоритмРасчета", Поле, АлгоритмРасчета);

КонецФункции

Функция КнопкаMAX(ТипКнопки, ТекстКнопки, Параметр = "")

	Кнопка = Новый Структура("type, text", ТипКнопки, ТекстКнопки);
	Если ТипКнопки = "open_app" И Не ПустаяСтрока(Параметр) Тогда
		// Пустое web_app означает мини-приложение, связанное с текущим ботом.
		// Стартовые параметры передаются отдельно в payload.
		Кнопка.Вставить("web_app", "");
		Кнопка.Вставить("payload", Параметр);
	ИначеЕсли ТипКнопки = "link" И Не ПустаяСтрока(Параметр) Тогда
		Кнопка.Вставить("url", Параметр);
	ИначеЕсли ТипКнопки = "callback" И Не ПустаяСтрока(Параметр) Тогда
		Кнопка.Вставить("payload", Параметр);
	КонецЕсли;
	Возврат Кнопка;

КонецФункции

Функция КнопкиВJSON(РядыКнопок)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, РядыКнопок);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция РядыИзОднойКнопки(Кнопка)

	РядыКнопок = Новый Массив;
	ДобавитьРядКнопок(РядыКнопок, Кнопка);
	Возврат РядыКнопок;

КонецФункции

Процедура ДобавитьРядКнопок(РядыКнопок, Кнопка)

	РядКнопок = Новый Массив;
	РядКнопок.Добавить(Кнопка);
	РядыКнопок.Добавить(РядКнопок);

КонецПроцедуры

Процедура УстановитьПризнакЗагрузки(Шаблоны)

	Идентификаторы = Новый Массив;
	Для Каждого Шаблон Из Шаблоны Цикл
		Идентификаторы.Добавить(Шаблон.Идентификатор);
	КонецЦикла;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Шаблоны.ИдентификаторСтандартногоШаблона КАК Идентификатор
		|ИЗ
		|	Справочник.бит_омни_ШаблоныСообщений КАК Шаблоны
		|ГДЕ
		|	Шаблоны.ИдентификаторСтандартногоШаблона В(&Идентификаторы)
		|	И НЕ Шаблоны.ПометкаУдаления");
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);

	Загруженные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Загруженные.Вставить(Выборка.Идентификатор, Истина);
	КонецЦикла;

	Для Каждого Шаблон Из Шаблоны Цикл
		Шаблон.УжеЗагружен = Загруженные.Получить(Шаблон.Идентификатор) = Истина;
	КонецЦикла;

КонецПроцедуры

Функция ПсевдонимыПоля(ИмяПоля)

	Псевдонимы = Новый Массив;
	Если ИмяПоля = "appointment_id" Тогда
		Псевдонимы.Добавить("appointmentId");
		Псевдонимы.Добавить("ИдентификаторЗаписи");
	ИначеЕсли ИмяПоля = "survey_id" Тогда
		Псевдонимы.Добавить("surveyId");
		Псевдонимы.Добавить("ИдентификаторАнкеты");
	ИначеЕсли ИмяПоля = "client_name" Тогда
		Псевдонимы.Добавить("НаименованиеКлиента");
		Псевдонимы.Добавить("ИмяКлиента");
	ИначеЕсли ИмяПоля = "appointment_date" Тогда
		Псевдонимы.Добавить("ДатаЗаписи");
	ИначеЕсли ИмяПоля = "appointment_time" Тогда
		Псевдонимы.Добавить("ВремяЗаписи");
	ИначеЕсли ИмяПоля = "doctor" Тогда
		Псевдонимы.Добавить("Врач");
	ИначеЕсли ИмяПоля = "address" Тогда
		Псевдонимы.Добавить("Адрес");
	ИначеЕсли ИмяПоля = "survey_title" Тогда
		Псевдонимы.Добавить("НаименованиеАнкеты");
		Псевдонимы.Добавить("surveyTemplateTitle");
	КонецЕсли;

	Возврат Псевдонимы;

КонецФункции

Функция СтроковоеЗначение(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

#КонецОбласти

Процедура ЗаписатьВходящееСообщениеMAX(Сообщение, Контакт, Бот)

	Если Контакт.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Тело = ЗначениеСвойства(Сообщение, "body");
	ИдентификаторСообщения = СтроковоеСвойство(Тело, "mid");
	Если ПустаяСтрока(ИдентификаторСообщения) Тогда
		ИдентификаторСообщения = Строка(Новый УникальныйИдентификатор);
	ИначеЕсли СообщениеЧатаУжеЗаписаноMAX(ИдентификаторСообщения, Контакт, Бот, Истина) Тогда
		Возврат;
	КонецЕсли;

	Текст = СтроковоеСвойство(Тело, "text");
	Вложения = ЗначениеСвойства(Тело, "attachments");
	ВидСообщения = ВидСообщенияMAX(Вложения);
	Если ПустаяСтрока(Текст) И Не ПустаяСтрока(ВидСообщения) Тогда
		Текст = СтрШаблон("[Вложение: %1]", ВидСообщения);
	КонецЕсли;

	Отправитель = ЗначениеСвойства(Сообщение, "sender");
	ЗаписатьСообщениеЧатаMAX(
		ИдентификаторСообщения,
		Контакт,
		Бот,
		Истина,
		Текст,
		ВидСообщения,
		ПредставлениеПользователяMAX(Отправитель),
		"Получено",
		"",
		JSONВложенийMAX(Вложения));

КонецПроцедуры

Процедура ЗаписатьИсходящееСообщениеMAX(
		ТелоСообщения,
		Получатель,
		Бот,
		ОтветMAX,
		КодСостояния,
		ТекстОтвета,
		ВидОтправителя = Неопределено,
		Пользователь = Неопределено)

	Если ТипЗнч(Получатель) <> Тип("СправочникСсылка.бит_омни_Контакты")
		Или Получатель.Пустая()
	Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторСообщения = ИдентификаторСообщенияИзОтветаMAX(ОтветMAX);
	Если ПустаяСтрока(ИдентификаторСообщения) Тогда
		ИдентификаторСообщения = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;

	Текст = СтроковоеСвойство(ТелоСообщения, "text");
	Вложения = ЗначениеСвойства(ТелоСообщения, "attachments");
	ВидСообщения = ВидСообщенияMAX(Вложения);
	Если ПустаяСтрока(Текст) И Не ПустаяСтрока(ВидСообщения) Тогда
		Текст = СтрШаблон("[Вложение: %1]", ВидСообщения);
	КонецЕсли;

	// Оператор передает себя явно, все остальные исходящие пишет бот.
	Если ВидОтправителя = Неопределено Тогда
		ВидОтправителя = Перечисления.бит_омни_ВидыОтправителейMAX.Бот;
	КонецЕсли;

	Если ВидОтправителя = Перечисления.бит_омни_ВидыОтправителейMAX.Оператор
		И ЗначениеЗаполнено(Пользователь) Тогда
		Автор = Строка(Пользователь);
	Иначе
		Автор = НСтр("ru='Клиника'");
	КонецЕсли;

	Успешно = КодСостояния >= 200 И КодСостояния < 300;
	ЗаписатьСообщениеЧатаMAX(
		ИдентификаторСообщения,
		Получатель,
		Бот,
		Ложь,
		Текст,
		ВидСообщения,
		Автор,
		?(Успешно, "Отправлено", "Ошибка"),
		?(Успешно, "", ТекстОтвета),
		JSONВложенийMAX(Вложения),
		ВидОтправителя,
		Пользователь);

КонецПроцедуры

Процедура ЗаписатьСообщениеЧатаMAX(
		ИдентификаторСообщения,
		Контакт,
		Бот,
		Входящее,
		Текст,
		ВидСообщения,
		Автор,
		Статус,
		ОписаниеОшибки,
		ДанныеВложений,
		ВидОтправителя = Неопределено,
		Пользователь = Неопределено)

	ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
	Если ДанныеБота = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.бит_омни_ИсторияЧатовMAX.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.ИдентификаторСообщения = Лев(ИдентификаторСообщения, 150);
	Запись.Контакт = Контакт;
	Запись.Бот = ДанныеБота.Ссылка;
	Запись.Входящее = Входящее;
	Запись.Текст = Текст;
	Запись.ВидСообщения = Лев(ВидСообщения, 50);
	Запись.Автор = Лев(Автор, 150);
	Запись.Прочитано = Не Входящее;
	Запись.Статус = Лев(Статус, 30);
	Запись.ОписаниеОшибки = ОписаниеОшибки;
	Запись.ДанныеВложений = ДанныеВложений;

	Если ВидОтправителя = Неопределено Тогда
		ВидОтправителя = ?(Входящее,
			Перечисления.бит_омни_ВидыОтправителейMAX.Пациент,
			Перечисления.бит_омни_ВидыОтправителейMAX.Бот);
	КонецЕсли;
	Запись.ВидОтправителя = ВидОтправителя;
	Запись.Пользователь = ?(Пользователь = Неопределено, Справочники.Пользователи.ПустаяСсылка(), Пользователь);

	Запись.Записать();
	//+бит_Сафаров ШИ 16.09.2026
	Если Входящее Тогда
		Пациент = Контакт.Получатель;
		Если ТипЗнч(Пациент) = Тип("СправочникСсылка.Клиенты")
			И Не Пациент.Пустая() Тогда
			СостояниеДиалога = РегистрыСведений.бит_омни_СостоянияДиалоговMAX.СоздатьМенеджерЗаписи();
			СостояниеДиалога.Пациент = Пациент;
			СостояниеДиалога.Бот = ДанныеБота.Ссылка;
			СостояниеДиалога.Прочитать();
			Если СостояниеДиалога.Состояние = Перечисления.бит_омни_СостоянияДиалоговMAX.Закрыт Тогда
				СостояниеДиалога.Состояние = Перечисления.бит_омни_СостоянияДиалоговMAX.Новый;
				СостояниеДиалога.Ответственный = Справочники.Пользователи.ПустаяСсылка();
				СостояниеДиалога.ДатаИзменения = ТекущаяДатаСеанса();
				СостояниеДиалога.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//-бит_Сафаров ШИ 16.09.2026

КонецПроцедуры

Функция СообщениеЧатаУжеЗаписаноMAX(ИдентификаторСообщения, Контакт, Бот, Входящее)

	ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
	Если ДанныеБота = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
				   |	ИсторияЧатов.Период КАК Период
				   |ИЗ
				   |	РегистрСведений.бит_омни_ИсторияЧатовMAX КАК ИсторияЧатов
				   |ГДЕ
				   |	ИсторияЧатов.ИдентификаторСообщения = &ИдентификаторСообщения
				   |	И ИсторияЧатов.Контакт = &Контакт
				   |	И ИсторияЧатов.Бот = &Бот
				   |	И ИсторияЧатов.Входящее = &Входящее";

	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщения);
	Запрос.УстановитьПараметр("Контакт", Контакт);
	Запрос.УстановитьПараметр("Бот", ДанныеБота.Ссылка);
	Запрос.УстановитьПараметр("Входящее", Входящее);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция ИдентификаторСообщенияИзОтветаMAX(ОтветMAX)

	Тело = ЗначениеСвойства(ОтветMAX, "body");
	Идентификатор = СтроковоеСвойство(Тело, "mid");
	Если Не ПустаяСтрока(Идентификатор) Тогда
		Возврат Идентификатор;
	КонецЕсли;

	Сообщение = ЗначениеСвойства(ОтветMAX, "message");
	Тело = ЗначениеСвойства(Сообщение, "body");
	Идентификатор = СтроковоеСвойство(Тело, "mid");
	Если Не ПустаяСтрока(Идентификатор) Тогда
		Возврат Идентификатор;
	КонецЕсли;

	Возврат СтроковоеСвойство(ОтветMAX, "mid");

КонецФункции

Функция ВидСообщенияMAX(Вложения)

	Если ТипЗнч(Вложения) <> Тип("Массив") Или Вложения.Количество() = 0 Тогда
		Возврат "text";
	КонецЕсли;

	Возврат СтроковоеСвойство(Вложения[0], "type", "attachment");

КонецФункции

Функция JSONВложенийMAX(Вложения)

	Если ТипЗнч(Вложения) <> Тип("Массив") Или Вложения.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат СтруктураВJSON(Вложения);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция ЭтоКомандаMAX(ТекстСообщения)

	Возврат ЗначениеЗаполнено(ТекстСообщения) И Лев(СокрЛП(ТекстСообщения), 1) = "/";

КонецФункции

Функция КомандаИзТекста(ТекстСообщения)

	ЧастиКоманды = СтрРазделить(СокрЛП(ТекстСообщения), " ");
	Если ЧастиКоманды.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат ЧастиКоманды[0];

КонецФункции

Функция СтроковоеСвойство(Данные, ИмяСвойства, ЗначениеПоУмолчанию = "")

	Значение = ЗначениеСвойства(Данные, ИмяСвойства, ЗначениеПоУмолчанию);
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция ЗначениеСвойства(Данные, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено)

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;
	Если Данные.Свойство(ИмяСвойства, Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция СтрокаИдентификатора(Идентификатор)

	Если Идентификатор = Неопределено Или Идентификатор = Null Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Идентификатор) = Тип("Число") Тогда
		Возврат Формат(Идентификатор, "ЧГ=0");
	КонецЕсли;

	Возврат СокрЛП(Строка(Идентификатор));

КонецФункции

Процедура ВыполнитьОбработчик(Обработчик, Сообщение, Контакт, Бот)

	Попытка
		УстановитьБезопасныйРежим(Истина);
		Выполнить (СтрШаблон("%1(Сообщение, Контакт, Бот);", Обработчик));
	Исключение
		//@skip-check undefined-type
		ЗаписьЖурналаРегистрации(
			"ОМНИ.MAX.ОшибкаОбработчика", УровеньЖурналаРегистрации.Ошибка, , , 
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьСобытиеВЖурнал(Обновление, Бот, Комментарий)

	ТипОбновления = СтроковоеСвойство(Обновление, "update_type");
	ИдентификаторСообщения = "";

	Сообщение = ЗначениеСвойства(Обновление, "message");
	Если ТипЗнч(Сообщение) = Тип("Структура") Тогда
		Тело = ЗначениеСвойства(Сообщение, "body");
		ИдентификаторСообщения = СтроковоеСвойство(Тело, "mid");
	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		"ОМНИ.MAX.Webhook", УровеньЖурналаРегистрации.Информация, , , СтрШаблон("%1. Тип: %2. MessageID: %3",
		Комментарий, ТипОбновления, ИдентификаторСообщения));

КонецПроцедуры

#КонецОбласти

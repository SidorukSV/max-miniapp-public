КонецПроцедуры

Процедура ОбработатьПолученныйКонтактMAX(ИнформацияОКонтакте, Контакт, Бот)

	Если ТипЗнч(ИнформацияОКонтакте) <> Тип("Структура")
		Или Контакт.Пустая()
	Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "Некорректные данные контакта");
		Возврат;
	КонецЕсли;

	ИнформацияОбАккаунтеMAX = ЗначениеСвойства(ИнформацияОКонтакте, "max_info");
	ИдентификаторКонтакта = ЗначениеСвойства(ИнформацияОбАккаунтеMAX, "user_id");
	Если СтрокаИдентификатора(ИдентификаторКонтакта) <> СтрокаИдентификатора(Контакт.Идентификатор) Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "Контакт принадлежит другому пользователю MAX");
		Возврат;
	КонецЕсли;

	VCF = ЗначениеСвойства(ИнформацияОКонтакте, "vcf_info", "");
	Если VCF = Неопределено Или VCF = Null Тогда
		VCF = "";
	Иначе
		// Завершающий перенос строки входит в подписываемые MAX данные VCard.
		// СтроковоеСвойство() здесь применять нельзя: СокрЛП() удалит этот перенос.
		VCF = Строка(VCF);
	КонецЕсли;
	VCF = НормализоватьVCFMAX(VCF);
	Хеш = НРег(СтроковоеСвойство(ИнформацияОКонтакте, "hash"));
	Если ПустаяСтрока(VCF)
		Или ПустаяСтрока(Хеш)
		Или Не ХешиРавныMAX(Хеш, HMACSHA256MAX(Бот.Токен, VCF))
	Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "Не подтверждена подпись контакта MAX");
		Возврат;
	КонецЕсли;

	НомерТелефона = НомерТелефонаИзVCFMAX(VCF);
	Если ПустаяСтрока(НомерТелефона) Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "В контакте отсутствует номер телефона");
		Возврат;
	КонецЕсли;

	ОшибкаСохранения = СохранитьПодтвержденныйТелефонMAX(Контакт, Бот, НомерТелефона);
	Если Не ПустаяСтрока(ОшибкаСохранения) Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, ОшибкаСохранения);
		Возврат;
	КонецЕсли;
	Клиенты = ПациентыПоТелефонуMAX(НомерТелефона);
	Если Клиенты.Количество() > 1 Тогда
		ОтправитьВыборПациентаMAX(Контакт, Бот, Клиенты);
		Возврат;
	ИначеЕсли Клиенты.Количество() = 0 Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "Клиент по номеру не найден");
		Возврат;
	КонецЕсли;

	Клиент = Клиенты[0];
	ОшибкаПривязки = ПривязатьПодтвержденныйКонтактMAX(Контакт, Клиент, Бот);
	Если Не ПустаяСтрока(ОшибкаПривязки) Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, ОшибкаПривязки);

		Возврат;
	КонецЕсли;

	// Привязка уже зафиксирована; последующие обработчики и HTTP-отправки выполняются без блокировки.
	КонтактОбъект = Контакт.ПолучитьОбъект();

	бит_омни_КонтактнаяИнформацияСерверПереопределяемый.ПослеПривязкиПользователяМессенджера(
		КонтактОбъект.Ссылка, Клиент, Бот, ИнформацияОКонтакте);

	//+бит_Сафаров ШИ 16.09.2026
	Контекст = Новый Структура("client_name, phone", бит_ИмяОтчествоКлиентаMAX(Клиент), НомерТелефона);
	//-бит_Сафаров ШИ 16.09.2026
	Если Не ОтправитьСтандартноеСообщениеMAX("MAX_AUTH_SUCCESS", КонтактОбъект.Ссылка, Бот, Контекст) Тогда
		ОтправитьТекстовоеСообщение(
			"Авторизация прошла успешно.", КонтактОбъект.Ссылка, Бот);
	КонецЕсли;

КонецПроцедуры

// Фиксирует подтверждённую привязку, не перезаписывая параллельный выбор оператора.
Функция ПривязатьПодтвержденныйКонтактMAX(Контакт, Клиент, Бот)

	ОшибкаПривязки = "";
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.бит_омни_Контакты");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Контакт);
		Блокировка.Заблокировать();

		// Ссылка могла быть прочитана до ручной привязки: проверяем только свежий объект под блокировкой.
		КонтактОбъект = Контакт.ПолучитьОбъект();
		Если КонтактОбъект.ПометкаУдаления Или КонтактОбъект.Заблокирован Тогда
			ОшибкаПривязки = "Контакт удалён или заблокирован";
		ИначеЕсли КонтактОбъект.Бот <> Бот Тогда
			ОшибкаПривязки = "Контакт относится к другому боту";
		ИначеЕсли ЗначениеЗаполнено(КонтактОбъект.Получатель) И КонтактОбъект.Получатель <> Клиент Тогда
			ОшибкаПривязки = "Контакт уже привязан к другому клиенту";
		ИначеЕсли Не ЗначениеЗаполнено(КонтактОбъект.Получатель) Тогда
			КонтактОбъект.Получатель = Клиент;
			КонтактОбъект.ОбменДанными.Загрузка = Истина;
			КонтактОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
			КонтактОбъект.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат ОшибкаПривязки;

КонецФункции

Процедура ОтправитьОтказВАторизацииMAX(Контакт, Бот, Причина)

	ЗаписьЖурналаРегистрации(
		"ОМНИ.MAX.Авторизация", УровеньЖурналаРегистрации.Предупреждение, , Контакт, Причина);

	Если Контакт.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Если Не ОтправитьСтандартноеСообщениеMAX("MAX_AUTH_DENIED", Контакт, Бот, Новый Структура("reason", Причина)) Тогда
		ОтправитьТекстовоеСообщение(
			"Не удалось выполнить авторизацию. Пожалуйста, свяжитесь с клиникой.", Контакт, Бот);
	КонецЕсли;

КонецПроцедуры

Функция ОтправитьСтандартноеСообщениеMAX(ИдентификаторШаблона, Контакт, Бот, Контекст = Неопределено)

	Шаблон = Справочники.бит_омни_ШаблоныСообщений.СтандартныйШаблон(ИдентификаторШаблона);
	Если Шаблон.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;

	ОтправитьСообщение(Шаблон, Контакт, Бот, Контекст);
	Возврат Истина;

КонецФункции

// Возвращает только номер, подтверждённый подписанным собственным контактом MAX.
Функция ТелефонКонтактаMAX(Контакт, Бот) Экспорт

	Если Не ЗначениеЗаполнено(Контакт) Тогда
		Возврат "";
	КонецЕсли;
	ОбъектКонтакта = Контакт.ПолучитьОбъект();
	Если ОбъектКонтакта.ПометкаУдаления Или ОбъектКонтакта.Бот <> Бот
		Или ОбъектКонтакта.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
		Возврат "";
	КонецЕсли;
	Если Не ПустаяСтрока(ОбъектКонтакта.ТелефонMAX) Тогда
		Возврат ОбъектКонтакта.ТелефонMAX;
	КонецЕсли;
	// В старых версиях номер оставался только в истории. Входящее сохраняется до проверки:
	// поэтому заново проверяем подпись и владельца, а не доверяем содержимому истории.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 50
	| История.ДанныеВложений КАК ДанныеВложений
	|ИЗ РегистрСведений.бит_омни_ИсторияЧатовMAX КАК История
	|ГДЕ История.Контакт = &Контакт
	| И История.Бот = &Бот
	| И История.Входящее
	| И История.ВидСообщения = &ВидСообщения
	|УПОРЯДОЧИТЬ ПО История.Период УБЫВ";
	Запрос.УстановитьПараметр("Контакт", Контакт);
	Запрос.УстановитьПараметр("Бот", Бот);
	Запрос.УстановитьПараметр("ВидСообщения", "contact");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			Вложения = JSONВСтруктуру(Выборка.ДанныеВложений);
		Исключение
			ЗаписьЖурналаРегистрации("ОМНИ.MAX.ЧтениеТелефона", УровеньЖурналаРегистрации.Предупреждение,
				, Контакт, "Не удалось прочитать вложение контакта из истории MAX");
			Продолжить;
		КонецПопытки;
		Если ТипЗнч(Вложения) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Вложение Из Вложения Цикл
			Если СтроковоеСвойство(Вложение, "type") <> "contact" Тогда
				Продолжить;
			КонецЕсли;
			Телефон = ТелефонПодписанногоВложенияMAX(ЗначениеСвойства(Вложение, "payload"),
				ОбъектКонтакта.Идентификатор, Бот.Токен);
			Если Не ПустаяСтрока(Телефон) Тогда
				Возврат Телефон;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ТелефонПодписанногоВложенияMAX(Данные, ИдентификаторКонтакта, Токен)

	ИнформацияMAX = ЗначениеСвойства(Данные, "max_info");
	Если СтрокаИдентификатора(ЗначениеСвойства(ИнформацияMAX, "user_id"))
		<> СтрокаИдентификатора(ИдентификаторКонтакта) Тогда
		Возврат "";
	КонецЕсли;
	VCF = ЗначениеСвойства(Данные, "vcf_info");
	Если ТипЗнч(VCF) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	VCF = НормализоватьVCFMAX(VCF);
	Хеш = НРег(СтроковоеСвойство(Данные, "hash"));
	Если ПустаяСтрока(VCF) Или ПустаяСтрока(Хеш)
		Или Не ХешиРавныMAX(Хеш, HMACSHA256MAX(Токен, VCF)) Тогда
		Возврат "";
	КонецЕсли;
	Возврат НомерТелефонаИзVCFMAX(VCF);

КонецФункции

// Массив уникальных непомеченных карточек Клиенты с точно совпадающим номером.
Функция ПациентыПоТелефонуMAX(НомерТелефона) Экспорт

	Клиенты = Новый Массив;
	Если ПустаяСтрока(НомерТелефона) Тогда
		Возврат Клиенты;
	КонецЕсли;
	НомерДляСравнения = КонтактнаяИнформацияКлиентСерверПереопределяемый.НормализоватьСотовыйТелефон(
		НомерТелефона, Ложь);
	Если ПустаяСтрока(НомерДляСравнения) Тогда
		Возврат Клиенты;
	КонецЕсли;
	ВидКонтактнойИнформации = бит_омни_ОбщегоНазначенияПолныеПрава.ЗначениеКонстанты(
		"ВидКонтактнойИнформации_ДляПоискаКлиента");
	НайденныеКонтакты = бит_омни_КонтактнаяИнформацияСерверПереопределяемый.НайтиОбъектыПоНомеруТелефона(
		НомерТелефона, Тип("СправочникСсылка.Клиенты"), Истина, ВидКонтактнойИнформации);
	Для Каждого НайденныйКонтакт Из НайденныеКонтакты Цикл
		Если НайденныйКонтакт.НомерЦифровой = НомерДляСравнения
			И Клиенты.Найти(НайденныйКонтакт.Объект) = Неопределено Тогда
			Клиенты.Добавить(НайденныйКонтакт.Объект);
		КонецЕсли;
	КонецЦикла;
	Возврат Клиенты;

КонецФункции

// Вызывается только после проверки подписи VCard и совпадения MAX user_id.
Функция СохранитьПодтвержденныйТелефонMAX(Контакт, Бот, Телефон)

	Ошибка = "";
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьКонтактДляВыбораMAX(Контакт);
		ОбъектКонтакта = Контакт.ПолучитьОбъект();
		Если ОбъектКонтакта.Бот <> Бот Или ОбъектКонтакта.Заблокирован
			Или ОбъектКонтакта.ПометкаУдаления Тогда
			Ошибка = "Контакт удалён, заблокирован или относится к другому боту";
		Иначе
			ОбъектКонтакта.ТелефонMAX = Телефон;
			ОбъектКонтакта.ВыборПациентаMAX = "";
			ЗаписатьКонтактВыбораMAX(ОбъектКонтакта);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Ошибка;

КонецФункции

Процедура ЗаблокироватьКонтактДляВыбораMAX(Контакт)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.бит_омни_Контакты");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Контакт);
	Блокировка.Заблокировать();

КонецПроцедуры

Процедура ЗаписатьКонтактВыбораMAX(ОбъектКонтакта)

	ОбъектКонтакта.ОбменДанными.Загрузка = Истина;
	ОбъектКонтакта.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	ОбъектКонтакта.Записать();

КонецПроцедуры

Процедура ПредложитьВыборПациентаMAX(Контакт, Бот)

	Телефон = ТелефонКонтактаMAX(Контакт, Бот);
	Если ПустаяСтрока(Телефон) Тогда
		ЗапроситьТелефонНепривязанногоКонтактаMAX(Контакт, Бот, Истина);
		Возврат;
	КонецЕсли;
	Клиенты = ПациентыПоТелефонуMAX(Телефон);
	Если Клиенты.Количество() = 0 Тогда
		ОтправитьТекстовоеСообщение("По переданному номеру телефона карточки пациентов не найдены. Обратитесь в клинику.",
			Контакт, Бот);
		Возврат;
	КонецЕсли;
	ОтправитьВыборПациентаMAX(Контакт, Бот, Клиенты);

КонецПроцедуры

Процедура ОтправитьВыборПациентаMAX(Контакт, Бот, Клиенты)

	ПодтвержденныйТелефон = ТелефонКонтактаMAX(Контакт, Бот);
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьКонтактДляВыбораMAX(Контакт);
		ОбъектКонтакта = Контакт.ПолучитьОбъект();
		Если ОбъектКонтакта.Бот = Бот И Не ОбъектКонтакта.Заблокирован
			И Не ОбъектКонтакта.ПометкаУдаления И Не ПустаяСтрока(ПодтвержденныйТелефон) Тогда
			Если ПустаяСтрока(ОбъектКонтакта.ТелефонMAX) Тогда
				ОбъектКонтакта.ТелефонMAX = ПодтвержденныйТелефон;
			КонецЕсли;
			Клиенты = ПациентыПоТелефонуMAX(ОбъектКонтакта.ТелефонMAX);
			Если Клиенты.Количество() > 0 Тогда
				ИдентификаторВыбора = Новый УникальныйИдентификатор;
				ОбъектКонтакта.ВыборПациентаMAX = Строка(ИдентификаторВыбора);
				ЗаписатьКонтактВыбораMAX(ОбъектКонтакта);
				ПараметрыСообщения = ПараметрыВыбораПациентаMAX(Клиенты, ОбъектКонтакта.ВыборПациентаMAX);
				ОтправитьСообщение(ПараметрыСообщения, Контакт, Бот);
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция ПараметрыВыбораПациентаMAX(Клиенты, ИдентификаторВыбора, Страница = 0)

	Ряды = Новый Массив;
	// MAX допускает 30 рядов: 29 карточек и один ряд навигации.
	РазмерСтраницы = 29;
	ПоследняяСтраница = Цел((Клиенты.Количество() - 1) / РазмерСтраницы);
	Страница = Макс(0, Мин(Страница, ПоследняяСтраница));
	Начало = Страница * РазмерСтраницы;
	Окончание = Мин(Начало + РазмерСтраницы, Клиенты.Количество()) - 1;
	Для Индекс = Начало По Окончание Цикл
		Клиент = Клиенты[Индекс];
		Ряд = Новый Массив;
		ДатаРождения = ?(ЗначениеЗаполнено(Клиент.ДатаРождения),
			Формат(Клиент.ДатаРождения, "ДФ=dd.MM.yyyy"), "дата рождения не указана");
		ТекстКнопки = Строка(Клиент) + ", " + ДатаРождения;
		Payload = "patient:" + ИдентификаторВыбора + ":" + Строка(Клиент.УникальныйИдентификатор());
		Ряд.Добавить(Новый Структура("type, text, payload", "callback", ТекстКнопки, Payload));
		Ряды.Добавить(Ряд);
	КонецЦикла;
	РядНавигации = Новый Массив;
	Если Страница > 0 Тогда
		РядНавигации.Добавить(Новый Структура("type, text, payload", "callback", "Назад",
			"patient_page:" + ИдентификаторВыбора + ":" + Формат(Страница - 1, "ЧГ=0")));
	КонецЕсли;
	Если Страница < ПоследняяСтраница Тогда
		РядНавигации.Добавить(Новый Структура("type, text, payload", "callback", "Далее",
			"patient_page:" + ИдентификаторВыбора + ":" + Формат(Страница + 1, "ЧГ=0")));
	КонецЕсли;
	Если РядНавигации.Количество() > 0 Тогда
		Ряды.Добавить(РядНавигации);
	КонецЕсли;
	Вложения = Новый Массив;
	Вложения.Добавить(Новый Структура("type, payload", "inline_keyboard", Новый Структура("buttons", Ряды)));
	Возврат Новый Структура("text, attachments", "Выберите пациента:", Вложения);

КонецФункции

Функция ОбработатьВыборПациентаMAX(Обновление, Бот)

	Callback = ЗначениеСвойства(Обновление, "callback");
	Payload = СтроковоеСвойство(Callback, "payload");
	ЭтоНавигация = Лев(Payload, 13) = "patient_page:";
	Если Не ЭтоНавигация И Лев(Payload, 8) <> "patient:" Тогда
		Возврат Ложь;
	КонецЕсли;
	CallbackId = СтроковоеСвойство(Callback, "callback_id");
	Если ПустаяСтрока(CallbackId) Тогда
		Возврат Истина;
	КонецЕсли;
	Контакт = ПолучитьКонтактПоUser(ЗначениеСвойства(Callback, "user"), Бот);
	Если Контакт.Пустая() Тогда
		ОтветитьНаCallbackMAX(CallbackId, Бот, "Не найден контакт MAX.");
		Возврат Истина;
	КонецЕсли;
	Если ЭтоНавигация Тогда
		ОбработатьСтраницуВыбораПациентаMAX(Payload, CallbackId, Контакт, Бот);
		Возврат Истина;
	КонецЕсли;
	Результат = ВыполнитьВыборПациентаMAX(Payload, CallbackId, Контакт, Бот);
	Если Результат.Успех Тогда
		ПустыеВложения = Новый Массив;
		ОтветитьНаCallbackMAX(CallbackId, Бот, Результат.Сообщение, Результат.Сообщение, ПустыеВложения);
	Иначе
		ОтветитьНаCallbackMAX(CallbackId, Бот, Результат.Сообщение);
	КонецЕсли;
	Возврат Истина;

КонецФункции

Процедура ОбработатьСтраницуВыбораПациентаMAX(Payload, CallbackId, Контакт, Бот)

	Части = СтрРазделить(Payload, ":", Истина);
	Если Части.Количество() <> 3 Или СтрДлина(Части[1]) <> 36 Тогда
		ОтветитьНаCallbackMAX(CallbackId, Бот, "Некорректная страница выбора.");
		Возврат;
	КонецЕсли;
	Страница = 0;
	Попытка
		Страница = Число(Части[2]);
	Исключение
		ОтветитьНаCallbackMAX(CallbackId, Бот, "Некорректная страница выбора.");
		Возврат;
	КонецПопытки;
	ОбъектКонтакта = Контакт.ПолучитьОбъект();
	Если ОбъектКонтакта.Бот <> Бот Или ОбъектКонтакта.Заблокирован
		Или ОбъектКонтакта.ПометкаУдаления Или ПустаяСтрока(ОбъектКонтакта.ТелефонMAX)
		Или ОбъектКонтакта.ВыборПациентаMAX <> Части[1] Тогда
		ОтветитьНаCallbackMAX(CallbackId, Бот, "Выбор устарел. Отправьте команду /patient.");
		Возврат;
	КонецЕсли;
	Клиенты = ПациентыПоТелефонуMAX(ОбъектКонтакта.ТелефонMAX);
	Если Клиенты.Количество() = 0 Тогда
		ОтветитьНаCallbackMAX(CallbackId, Бот, "Карточки по номеру больше не найдены.");
		Возврат;
	КонецЕсли;
	ПараметрыСообщения = ПараметрыВыбораПациентаMAX(Клиенты, Части[1], Цел(Страница));
	ОтветитьНаCallbackMAX(CallbackId, Бот, "Выберите пациента", ПараметрыСообщения.text,
		ПараметрыСообщения.attachments);

КонецПроцедуры

// Свежий номер и состав карточек проверяются под той же блокировкой, что и ручная привязка.
Функция ВыполнитьВыборПациентаMAX(Payload, CallbackId, Контакт, Бот)

	Результат = Новый Структура("Успех, Сообщение", Ложь, "Выбор устарел. Отправьте команду /patient.");
	Части = СтрРазделить(Payload, ":", Истина);
	Если Части.Количество() <> 3 Или СтрДлина(Части[1]) <> 36 Или СтрДлина(Части[2]) <> 36 Тогда
		Возврат Результат;
	КонецЕсли;
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(CallbackId);
	ИдентификаторСообщения = "patient:" + Base64Строка(Хеширование.ХешСумма);
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьКонтактДляВыбораMAX(Контакт);
		ОбъектКонтакта = Контакт.ПолучитьОбъект();
		Если ОбъектКонтакта.Бот = Бот И Не ОбъектКонтакта.Заблокирован
			И Не ОбъектКонтакта.ПометкаУдаления Тогда
			Если СообщениеЧатаУжеЗаписаноMAX(ИдентификаторСообщения, Контакт, Бот, Истина) Тогда
				Результат.Успех = Истина;
				Результат.Сообщение = "Выбор уже обработан.";
			ИначеЕсли ОбъектКонтакта.ВыборПациентаMAX = Части[1]
				И Не ПустаяСтрока(ОбъектКонтакта.ТелефонMAX) Тогда
				Клиенты = ПациентыПоТелефонуMAX(ОбъектКонтакта.ТелефонMAX);
				Для Каждого Клиент Из Клиенты Цикл
					Если Строка(Клиент.УникальныйИдентификатор()) = Части[2] Тогда
						ОбъектКонтакта.Получатель = Клиент;
						ОбъектКонтакта.ВыборПациентаMAX = "";
						ЗаписатьКонтактВыбораMAX(ОбъектКонтакта);
						Результат.Успех = Истина;
						Результат.Сообщение = "Выбран пациент: " + Строка(Клиент);
						ЗаписатьСообщениеЧатаMAX(ИдентификаторСообщения, Контакт, Бот, Истина,
							Результат.Сообщение, "contact_action", Строка(Контакт), "Получено", "", "");
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

Функция НормализоватьVCFMAX(VCF)

	Результат = СтрЗаменить(VCF, "\r\n", Символы.ВК + Символы.ПС);
	Результат = СтрЗаменить(Результат, "\n", Символы.ПС);
	Возврат Результат;

КонецФункции

Функция НомерТелефонаИзVCFMAX(VCF)

	СтрокиVCF = СтрРазделить(СтрЗаменить(VCF, Символы.ВК, ""), Символы.ПС, Ложь);
	Для Каждого СтрокаVCF Из СтрокиVCF Цикл
		Если Лев(ВРег(СтрокаVCF), 3) <> "TEL" Тогда
			Продолжить;
		КонецЕсли;

		ПозицияРазделителя = СтрНайти(СтрокаVCF, ":");
		Если ПозицияРазделителя > 0 Тогда
			Возврат СокрЛП(Сред(СтрокаVCF, ПозицияРазделителя + 1));
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция HMACSHA256MAX(Ключ, Данные)

	РазмерБлока = 64;
	БуферКлюча = ПолучитьБуферДвоичныхДанныхИзСтроки(Ключ, КодировкаТекста.UTF8, Ложь);

	Если БуферКлюча.Размер > РазмерБлока Тогда
		ХешКлюча = Новый ХешированиеДанных(ХешФункция.SHA256);
		ХешКлюча.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(БуферКлюча));
		БуферКлюча = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ХешКлюча.ХешСумма);
	КонецЕсли;

	КлючБлока = Новый БуферДвоичныхДанных(РазмерБлока);
	КлючБлока.Записать(0, БуферКлюча);

	ВнутреннийКлюч = Новый БуферДвоичныхДанных(РазмерБлока);
	ВнешнийКлюч = Новый БуферДвоичныхДанных(РазмерБлока);
	Для Индекс = 0 По РазмерБлока - 1 Цикл
		ВнутреннийКлюч.Установить(Индекс, 54);
		ВнешнийКлюч.Установить(Индекс, 92);
	КонецЦикла;
	ВнутреннийКлюч.ЗаписатьПобитовоеИсключительноеИли(0, КлючБлока);
	ВнешнийКлюч.ЗаписатьПобитовоеИсключительноеИли(0, КлючБлока);

	ВнутреннийХеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	ВнутреннийХеш.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ВнутреннийКлюч));
	ВнутреннийХеш.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Данные, КодировкаТекста.UTF8, Ложь));

	ВнешнийХеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	ВнешнийХеш.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ВнешнийКлюч));
	ВнешнийХеш.Добавить(ВнутреннийХеш.ХешСумма);

	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ВнешнийХеш.ХешСумма));

КонецФункции

Функция ХешиРавныMAX(ПервыйХеш, ВторойХеш)

	Если СтрДлина(ПервыйХеш) <> СтрДлина(ВторойХеш) Тогда
		Возврат Ложь;
	КонецЕсли;

	РезультатСравнения = 0;
	Для Индекс = 1 По СтрДлина(ПервыйХеш) Цикл
		Если Сред(ПервыйХеш, Индекс, 1) <> Сред(ВторойХеш, Индекс, 1) Тогда
			РезультатСравнения = РезультатСравнения + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат РезультатСравнения = 0;

КонецФункции

Функция ЭтоШаблонСообщенияMAX(ПараметрыСообщения)

	ТипПараметров = ТипЗнч(ПараметрыСообщения);

	Возврат ТипПараметров = Тип("СправочникСсылка.бит_омни_ШаблоныСообщений") Или ТипПараметров = Тип(
		"СправочникОбъект.бит_омни_ШаблоныСообщений");


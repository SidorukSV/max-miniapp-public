Функция ПараметрыСообщенияMAX(ПараметрыСообщения, Получатель, Контекст, ДанныеБота)

	Если Не ЭтоШаблонСообщенияMAX(ПараметрыСообщения) Тогда
		Возврат ПараметрыСообщения;
	КонецЕсли;

	ТекстСообщения = бит_омни_РаботаССообщениями.СформироватьТекстСообщенияПоШаблону(ПараметрыСообщения, Получатель,
		Контекст);
	ПараметрыТекущегоСообщения = Новый Структура("text", ТекстСообщения);

	Формат = ПараметрыСообщения.ВариантФормата;
	Если ЗначениеЗаполнено(Формат) Тогда
		ПараметрыТекущегоСообщения.Вставить("format", НРег(Формат));
	КонецЕсли;

	Кнопки = Справочники.бит_омни_ШаблоныСообщений.СформироватьКнопкиПоШаблону(
		ПараметрыСообщения, Получатель, Контекст);
	Если Кнопки.Количество() > 0 Тогда
		//+бит_Сафаров ШИ 01.09.2026
		ПривестиКнопкиДействийЗаписиКCallbackMAX(Кнопки, ПараметрыСообщения);
	КонецЕсли;
	Если Кнопки.Количество() > 0 Тогда
		//-бит_Сафаров ШИ 01.09.2026
		ЗаполнитьWebAppКнопокMAX(Кнопки, ДанныеБота);
		Вложения = Новый Массив;
		Вложения.Добавить(Новый Структура(
			"type, payload", "inline_keyboard", Новый Структура("buttons", Кнопки)));
		ПараметрыТекущегоСообщения.Вставить("attachments", Вложения);
	КонецЕсли;

	Возврат ПараметрыТекущегоСообщения;

КонецФункции

//+бит_Сафаров ШИ 01.09.2026
Процедура ПривестиКнопкиДействийЗаписиКCallbackMAX(РядыКнопок, ШаблонСообщения)

	ПоказыватьПодтвердить = ШаблонСообщения.ПоказыватьПодтвердитьMAX;
	ПоказыватьПеренести = ШаблонСообщения.ПоказыватьПеренестиMAX;
	ПоказыватьОтменить = ШаблонСообщения.ПоказыватьОтменитьMAX;

	НомерРяда = РядыКнопок.Количество() - 1;
	Пока НомерРяда >= 0 Цикл
		РядКнопок = РядыКнопок[НомерРяда];
		НомерКнопки = РядКнопок.Количество() - 1;
		Пока НомерКнопки >= 0 Цикл
			Кнопка = РядКнопок[НомерКнопки];
			Если Не НастроитьКнопкуДействияЗаписиMAX(Кнопка,
				ПоказыватьПодтвердить, ПоказыватьПеренести, ПоказыватьОтменить) Тогда
				РядКнопок.Удалить(НомерКнопки);
			КонецЕсли;
			НомерКнопки = НомерКнопки - 1;
		КонецЦикла;

		Если РядКнопок.Количество() = 0 Тогда
			РядыКнопок.Удалить(НомерРяда);
		КонецЕсли;
		НомерРяда = НомерРяда - 1;
	КонецЦикла;

КонецПроцедуры

Функция НастроитьКнопкуДействияЗаписиMAX(
	Кнопка, ПоказыватьПодтвердить, ПоказыватьПеренести, ПоказыватьОтменить)

	Payload = СтроковоеСвойство(Кнопка, "payload");
	Если Лев(Payload, СтрДлина("appointment_")) <> "appointment_" Тогда
		Возврат Истина;
	КонецЕсли;

	Если Прав(Payload, СтрДлина("_confirm")) = "_confirm" Тогда
		Если Не ПоказыватьПодтвердить Тогда
			Возврат Ложь;
		КонецЕсли;
		Кнопка.Вставить("type", "callback");
		Если Кнопка.Свойство("web_app") Тогда
			Кнопка.Удалить("web_app");
		КонецЕсли;
	ИначеЕсли Прав(Payload, СтрДлина("_reschedule")) = "_reschedule" Тогда
		Если Не ПоказыватьПеренести Тогда
			Возврат Ложь;
		КонецЕсли;
		Кнопка.Вставить("type", "open_app");
	ИначеЕсли Прав(Payload, СтрДлина("_cancel")) = "_cancel" Тогда
		Если Не ПоказыватьОтменить Тогда
			Возврат Ложь;
		КонецЕсли;
		Кнопка.Вставить("type", "callback");
		Если Кнопка.Свойство("web_app") Тогда
			Кнопка.Удалить("web_app");
		КонецЕсли;
	Иначе
		Возврат Истина;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ВложенияПослеДействияЗаписиMAX(ИсходноеСообщение, Действие)

	Если Действие = "cancel" Тогда
		Возврат Новый Массив;
	КонецЕсли;

	ТелоСообщения = ЗначениеСвойства(ИсходноеСообщение, "body");
	Вложения = ЗначениеСвойства(ТелоСообщения, "attachments");
	Если ТипЗнч(Вложения) <> Тип("Массив") Тогда
		Возврат Новый Массив;
	КонецЕсли;

	НомерВложения = Вложения.Количество() - 1;
	Пока НомерВложения >= 0 Цикл
		Вложение = Вложения[НомерВложения];
		Если СтроковоеСвойство(Вложение, "type") = "inline_keyboard" Тогда
			ДанныеКлавиатуры = ЗначениеСвойства(Вложение, "payload");
			РядыКнопок = ЗначениеСвойства(ДанныеКлавиатуры, "buttons");
			УдалитьКнопкуПодтвержденияMAX(РядыКнопок);
			Если ТипЗнч(РядыКнопок) = Тип("Массив") И РядыКнопок.Количество() = 0 Тогда
				Вложения.Удалить(НомерВложения);
			КонецЕсли;
		КонецЕсли;
		НомерВложения = НомерВложения - 1;
	КонецЦикла;

	Возврат Вложения;

КонецФункции

Процедура УдалитьКнопкуПодтвержденияMAX(РядыКнопок)

	Если ТипЗнч(РядыКнопок) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	НомерРяда = РядыКнопок.Количество() - 1;
	Пока НомерРяда >= 0 Цикл
		РядКнопок = РядыКнопок[НомерРяда];
		Если ТипЗнч(РядКнопок) = Тип("Массив") Тогда
			НомерКнопки = РядКнопок.Количество() - 1;
			Пока НомерКнопки >= 0 Цикл
				Payload = СтроковоеСвойство(РядКнопок[НомерКнопки], "payload");
				Если Лев(Payload, СтрДлина("appointment_")) = "appointment_"
					И Прав(Payload, СтрДлина("_confirm")) = "_confirm" Тогда
					РядКнопок.Удалить(НомерКнопки);
				КонецЕсли;
				НомерКнопки = НомерКнопки - 1;
			КонецЦикла;
			Если РядКнопок.Количество() = 0 Тогда
				РядыКнопок.Удалить(НомерРяда);
			КонецЕсли;
		КонецЕсли;
		НомерРяда = НомерРяда - 1;
	КонецЦикла;

КонецПроцедуры

Функция ОтветитьНаCallbackMAX(CallbackId, Бот, Уведомление, ТекстСообщения = "", Вложения = Неопределено)

	ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
	Если ДанныеБота = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ТелоОтвета = Новый Структура("notification", Уведомление);
	Если Не ПустаяСтрока(ТекстСообщения) Тогда
		Сообщение = Новый Структура("text", ТекстСообщения);
		Если Вложения <> Неопределено Тогда
			Сообщение.Вставить("attachments", Вложения);
		КонецЕсли;
		ТелоОтвета.Вставить("message", Сообщение);
	КонецЕсли;

	Соединение = бит_омни_ИнтеграцияСMAXПовтИсп.СоединениеCAPI();
	Заголовки = ЗаголовкиMAX(ДанныеБота.Токен);
	Заголовки.Вставить("Content-Type", "application/json");
	КодированныйCallbackId = КодироватьСтроку(CallbackId, СпособКодированияСтроки.КодировкаURL);
	Запрос = Новый HTTPЗапрос("/answers?callback_id=" + КодированныйCallbackId, Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтруктураВJSON(ТелоОтвета), КодировкаТекста.UTF8);

	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
		Возврат Истина;
	КонецЕсли;

	ДанныеОтвета = ПрочитатьОтветMAX(Ответ);
	ЗаписьЖурналаРегистрации(
		"ОМНИ.MAX.ОшибкаCallback", УровеньЖурналаРегистрации.Ошибка, , , СтрШаблон(
		"Код ответа MAX: %1. Тело ответа: %2", Ответ.КодСостояния, ДанныеОтвета.Текст));
	Возврат Ложь;

КонецФункции

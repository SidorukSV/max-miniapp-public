#Область ПрограммныйИнтерфейс

// Добавляет встроенную команду, сохраняя остальные команды меню MAX.
// Параметры:
//  Токен - Строка - токен выбранного бота MAX.
// Возвращаемое значение:
//  Булево - Истина, если меню изменено; Ложь, если команда уже зарегистрирована.
Функция ЗарегистрироватьКомандыMAX(Токен) Экспорт

	Если ПустаяСтрока(Токен) Тогда
		ВызватьИсключение "Укажите токен MAX.";
	КонецЕсли;
	Соединение = бит_омни_ИнтеграцияСMAXПовтИсп.СоединениеCAPI();
	Заголовки = ЗаголовкиMAX(Токен);
	Запрос = Новый HTTPЗапрос("/me", Заголовки);
	Ответ = Соединение.Получить(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон("Не удалось получить команды MAX. Код HTTP: %1.", Ответ.КодСостояния);
	КонецЕсли;
	ДанныеОтвета = ПрочитатьОтветMAX(Ответ);
	Меню = МенюКомандПациентаMAX(ДанныеОтвета.Тело);
	Если Не Меню.Изменено Тогда
		Возврат Ложь;
	КонецЕсли;
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос("/me/commands", Заголовки);
	Запрос.УстановитьТелоИзСтроки(
		СтруктураВJSON(Новый Структура("commands", Меню.Команды)), КодировкаТекста.UTF8);
	Ответ = Соединение.ВызватьHTTPМетод("PATCH", Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон("Не удалось зарегистрировать команды MAX. Код HTTP: %1.", Ответ.КодСостояния);
	КонецЕсли;
	ДанныеОтвета = ПрочитатьОтветMAX(Ответ);
	ПроверенноеМеню = МенюКомандПациентаMAX(ДанныеОтвета.Тело);
	Если ПроверенноеМеню.Изменено Тогда
		ВызватьИсключение "MAX не подтвердил регистрацию команды /patient. Проверьте меню бота.";
	КонецЕсли;
	Если ПроверенноеМеню.Команды.Количество() <> Меню.Команды.Количество() Тогда
		ВызватьИсключение "MAX вернул другой состав команд после регистрации. Проверьте меню бота.";
	КонецЕсли;
	Для Каждого Команда Из Меню.Команды Цикл
		Сохранена = Ложь;
		Для Каждого КомандаОтвета Из ПроверенноеМеню.Команды Цикл
			Если КомандаОтвета.name = Команда.name
				И ЗначениеСвойства(КомандаОтвета, "description") = ЗначениеСвойства(Команда, "description") Тогда
				Сохранена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Сохранена Тогда
			ВызватьИсключение "MAX не подтвердил сохранение прежних команд. Проверьте меню бота.";
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция МенюКомандПациентаMAX(ДанныеБота)

	Если ТипЗнч(ДанныеБота) <> Тип("Структура") Тогда
		ВызватьИсключение "Некорректный ответ MAX: меню команд не изменено.";
	КонецЕсли;
	ИсходныеКоманды = ЗначениеСвойства(ДанныеБота, "commands");
	Если ИсходныеКоманды = Неопределено Или ИсходныеКоманды = Null Тогда
		ИсходныеКоманды = Новый Массив;
	КонецЕсли;
	Если ТипЗнч(ИсходныеКоманды) <> Тип("Массив") Тогда
		ВызватьИсключение "Некорректный список команд MAX: меню не изменено.";
	КонецЕсли;
	Команды = Новый Массив;
	Найдена = Ложь;
	Изменено = Ложь;
	Описание = "Выбрать пациента";
	Для Каждого Команда Из ИсходныеКоманды Цикл
		Имя = ЗначениеСвойства(Команда, "name");
		Если ТипЗнч(Имя) <> Тип("Строка") Или ПустаяСтрока(Имя) Тогда
			ВызватьИсключение "Некорректная команда MAX: меню не изменено.";
		КонецЕсли;
		Если Имя = "patient" Тогда
			Если Найдена Тогда
				ВызватьИсключение "В меню MAX повторяется команда /patient. Проверьте настройки бота.";
			КонецЕсли;
			Найдена = Истина;
			Изменено = ЗначениеСвойства(Команда, "description") <> Описание;
			Команды.Добавить(Новый Структура("name, description", "patient", Описание));
		Иначе
			Команды.Добавить(Команда);
		КонецЕсли;
	КонецЦикла;
	Если Не Найдена Тогда
		Команды.Добавить(Новый Структура("name, description", "patient", Описание));
		Изменено = Истина;
	КонецЕсли;
	Если Команды.Количество() > 32 Тогда
		ВызватьИсключение "В меню MAX уже 32 команды. Освободите место для /patient; меню не изменено.";
	КонецЕсли;
	Возврат Новый Структура("Команды, Изменено", Команды, Изменено);

КонецФункции

Функция ИнформацияОБоте(Токен) Экспорт

	Соединение = бит_омни_ИнтеграцияСMAXПовтИсп.СоединениеCAPI();
	Заголовки = ЗаголовкиMAX(Токен);

	Запрос = Новый HTTPЗапрос("/me", Заголовки);
	Ответ = Соединение.Получить(Запрос);

	ДанныеОтвета = ПрочитатьОтветMAX(Ответ);
	Если Ответ.КодСостояния <> 200 Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Код ошибки: %1
														|Текст ошибки: %2", Ответ.КодСостояния, ДанныеОтвета.Текст));
		Возврат Неопределено;
	КонецЕсли;

	Возврат ДанныеОтвета.Тело;

КонецФункции

// Отправляет текстовое сообщение через бота в мессенджер MAX с возможностью указания форматирования.
//
// Параметры:
//   ТекстСообщения - Строка - текст отправляемого сообщения
//   Получатель - - получатель сообщения
//     - Массив из СправочникСсылка.бит_омни_Контакты, СправочникСсылка.Сотрудники, СправочникСсылка.Клиенты  
//     - СправочникСсылка.бит_омни_Контакты
//     - СправочникСсылка.Сотрудники
//     - СправочникСсылка.Клиенты
//   Бот - СправочникСсылка.бит_омни_Боты - идентификатор бота, от имени которого отправляется сообщение
//   Формат - Строка - форматирование текста сообщения (например, "markdown", "html")
//           - Неопределено - используется форматирование по умолчанию
//
// Возвращаемое значение:
//   см. бит_омни_ИнтеграцияСMAX.ОтправитьСообщение
Функция ОтправитьТекстовоеСообщение(ТекстСообщения, Получатель, Бот, Формат = Неопределено,
	ВидОтправителя = Неопределено, Пользователь = Неопределено) Экспорт

	ПараметрыСообщения = Новый Структура("text", ТекстСообщения);

	Если ЗначениеЗаполнено(Формат) Тогда
		ПараметрыСообщения.Вставить("format", Формат);
	КонецЕсли;

	Возврат ОтправитьСообщение(ПараметрыСообщения, Получатель, Бот, , ВидОтправителя, Пользователь);

КонецФункции

// Отправляет сообщение через интеграцию с MAX одному или нескольким получателям
//
// Параметры:
//   ПараметрыСообщения - Структура, СправочникСсылка.бит_омни_ШаблоныСообщений - параметры сообщения (зависят от типа сообщения)
//   Получатель - Строка, Массив из Строка - идентификатор получателя или массив получателей
//   Бот - Строка - идентификатор бота
//   Контекст - Структура, Неопределено - дополнительные параметры для отправки сообщения
//
// Возвращаемое значение:
//   см. бит_омни_ИнтеграцияСMAX.ОтправитьСообщениеПолучателю
Функция ОтправитьСообщение(ПараметрыСообщения, Получатель, Бот, Контекст = Неопределено,
	ВидОтправителя = Неопределено, Пользователь = Неопределено) Экспорт

	ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
	Если ДанныеБота = Неопределено Тогда
		Возврат Новый Структура("success, message", Ложь, НСтр("ru='Не найден бот MAX'"));
	КонецЕсли;

	Получатели = ПолучателиСообщенияMAX(Получатель);
	Если ТипЗнч(Получатель) = Тип("Массив") Тогда

		РезультатыОтправки = Новый Массив;
		Для Каждого ТекущийПолучатель Из Получатели Цикл
			РезультатыОтправки.Добавить(ОтправитьСообщениеПолучателю(ПараметрыСообщения, ТекущийПолучатель, Бот,
				ДанныеБота, Контекст, ВидОтправителя, Пользователь));
		КонецЦикла;

		Возврат РезультатыОтправки;

	КонецЕсли;

	Если Получатели.Количество() = 0 Тогда
		Возврат Новый Структура("success, message", Ложь, НСтр("ru='Не определен получатель сообщения MAX'"));
	КонецЕсли;

	Возврат ОтправитьСообщениеПолучателю(ПараметрыСообщения, Получатели[0], Бот, ДанныеБота, Контекст,
		ВидОтправителя, Пользователь);

КонецФункции

//+бит_Сафаров ШИ 16.09.2026
Функция бит_ИмяОтчествоКлиентаMAX(Клиент) Экспорт

	Если ТипЗнч(Клиент) <> Тип("СправочникСсылка.Клиенты")
		Или Клиент.Пустая() Тогда
		Возврат "";
	КонецЕсли;

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Клиент, "Имя, Отчество");
	Имя = СокрЛП(Реквизиты.Имя);
	Отчество = СокрЛП(Реквизиты.Отчество);
	Возврат СокрЛП(Имя + " " + Отчество);

КонецФункции
//-бит_Сафаров ШИ 16.09.2026

Функция ОтправитьСообщениеПолучателю(ПараметрыСообщения, Получатель, Бот, ДанныеБота, Контекст,
	ВидОтправителя = Неопределено, Пользователь = Неопределено)

	ПолучательСообщения = ПолучательСообщенияMAX(Получатель, Бот);
	Адресат = ПараметрыАдресата(ПолучательСообщения, Бот);
	Если Адресат = Неопределено Тогда
		Возврат Новый Структура("success, message", Ложь, НСтр("ru='Не определен получатель сообщения MAX'"));
	КонецЕсли;

	ПараметрыТекущегоСообщения = ПараметрыСообщенияMAX(
		ПараметрыСообщения, ПолучательСообщения, Контекст, ДанныеБота);
	ТелоСообщения = ТелоСообщенияMAX(ПараметрыТекущегоСообщения);
	//+бит_Сафаров ШИ 16.09.2026
	Если ТелоСообщения <> Неопределено
		И ВидОтправителя = Неопределено
		И ЭтоШаблонСообщенияMAX(ПараметрыСообщения)
		И Лев(ПараметрыСообщения.ИдентификаторСтандартногоШаблона, 16) = "MAX_APPOINTMENT_"
		И Не ПустаяСтрока(СтроковоеСвойство(ТелоСообщения, "text"))
		И ТипЗнч(ПолучательСообщения) = Тип("СправочникСсылка.бит_омни_Контакты") Тогда
		Клиент = ПолучательСообщения.Получатель;
		Обращение = бит_ИмяОтчествоКлиентаMAX(Клиент);
		Если Не ПустаяСтрока(Обращение) Тогда
			ТелоСообщения.Вставить("text", Обращение + ", " + ТелоСообщения.text);
		КонецЕсли;
	КонецЕсли;
	//-бит_Сафаров ШИ 16.09.2026
	Если ТелоСообщения = Неопределено Тогда
		Возврат Новый Структура("success, message", Ложь, НСтр("ru='Не заполнен текст или вложения сообщения MAX'"));
	КонецЕсли;

	СтрокаЗапроса = СтруктураВJSON(ТелоСообщения);

	Соединение = бит_омни_ИнтеграцияСMAXПовтИсп.СоединениеCAPI();
	Заголовки = ЗаголовкиMAX(ДанныеБота.Токен);
	Заголовки.Вставить("Content-Type", "application/json");

	Ресурс = СтрШаблон("/messages?%1=%2", Адресат.Параметр, Адресат.Значение);
	Запрос = Новый HTTPЗапрос(Ресурс, Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтрокаЗапроса, КодировкаТекста.UTF8);

	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	ДанныеОтвета = ПрочитатьОтветMAX(Ответ);

	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		ЗаписьЖурналаРегистрации(
			"ОМНИ.MAX.ОшибкаОтправки", УровеньЖурналаРегистрации.Ошибка, , , СтрШаблон(
			"Код ответа MAX: %1. Тело ответа: %2", Ответ.КодСостояния, ДанныеОтвета.Текст));
	КонецЕсли;

	ЗаписатьИсходящееСообщениеMAX(
		ТелоСообщения, ПолучательСообщения, Бот, ДанныеОтвета.Тело, Ответ.КодСостояния, ДанныеОтвета.Текст,
		ВидОтправителя, Пользователь);

	Возврат ДанныеОтвета.Тело;

КонецФункции

Функция ОбработатьWebhook(HTTPЗапрос, Бот) Экспорт

	Попытка
		Обновление = бит_омни_ИнтеграцияСервер.ТелоЗапросаВСтруктуру(HTTPЗапрос);
		Если ТипЗнч(Обновление) <> Тип("Структура") Тогда
			Возврат бит_омни_ИнтеграцияСервер.ОтветСОшибкой("invalid_max_update");
		КонецЕсли;

		ОбработатьОбновление(Обновление, Бот);

		Возврат бит_омни_ИнтеграцияСервер.УспешныйОтвет(Новый Структура("success", Истина));

	Исключение
		ИнфоОшибки = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнфоОшибки);

		ЗаписьЖурналаРегистрации(
			"ОМНИ.MAX.Webhook", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);

		Возврат бит_омни_ИнтеграцияСервер.ОтветСОшибкой("max_webhook_error", 500, ТекстОшибки);
	КонецПопытки;

КонецФункции

Процедура ОбработатьОбновление(Обновление, Бот) Экспорт

	ТипОбновления = СтроковоеСвойство(Обновление, "update_type");

	Если ТипОбновления = "message_created" Тогда
		ОбработатьСозданиеСообщения(Обновление, Бот);
	ИначеЕсли ТипОбновления = "bot_started" Тогда
		ОбработатьЗапускБота(Обновление, Бот);
	ИначеЕсли ТипОбновления = "bot_stopped" Тогда
		ОбработатьОстановкуБота(Обновление, Бот);
	ИначеЕсли ТипОбновления = "message_callback" Тогда
		ОбработатьCallback(Обновление, Бот);
	Иначе
		ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Событие MAX пропущено'"));
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьКонтактПоUser(User, Бот) Экспорт

	Если ТипЗнч(User) <> Тип("Структура") Тогда
		Возврат Справочники.бит_омни_Контакты.ПустаяСсылка();
	КонецЕсли;

	ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
	Если ДанныеБота = Неопределено Тогда
		Возврат Справочники.бит_омни_Контакты.ПустаяСсылка();
	КонецЕсли;

	ИдентификаторПользователя = ЗначениеСвойства(User, "user_id");
	Если Не ЗначениеЗаполнено(ИдентификаторПользователя) Тогда
		Возврат Справочники.бит_омни_Контакты.ПустаяСсылка();
	КонецЕсли;

	Контакт = НайтиКонтактMAX(ИдентификаторПользователя, ДанныеБота.Ссылка);
	Если Не Контакт.Пустая() Тогда
		Возврат Контакт;
	КонецЕсли;

	КонтактОбъект = Справочники.бит_омни_Контакты.СоздатьЭлемент();
	КонтактОбъект.Наименование = Лев(ПредставлениеПользователяMAX(User), 25);
	КонтактОбъект.Идентификатор = ИдентификаторПользователя;
	КонтактОбъект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
	КонтактОбъект.Бот = ДанныеБота.Ссылка;
	КонтактОбъект.ОбменДанными.Загрузка = Истина;
	КонтактОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	КонтактОбъект.Записать();

	Возврат КонтактОбъект.Ссылка;

КонецФункции

#КонецОбласти

#Область ОбработкаВходящихСобытий

Процедура ОбработатьСозданиеСообщения(Обновление, Бот)

	Сообщение = ЗначениеСвойства(Обновление, "message");
	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Отправитель = ЗначениеСвойства(Сообщение, "sender");
	Если ЗначениеСвойства(Отправитель, "is_bot", Ложь) Тогда
		Возврат;
	КонецЕсли;

	Контакт = ПолучитьКонтактПоUser(Отправитель, Бот);
	ТекстСообщения = ТекстСообщенияMAX(Сообщение);

	ЗаписатьВходящееСообщениеMAX(Сообщение, Контакт, Бот);

	Если ЭтоКомандаMAX(ТекстСообщения) Тогда
		ОбработатьКоманду(Сообщение, Контакт, Бот, КомандаИзТекста(ТекстСообщения));
	Иначе
		ОбработатьСообщение(Сообщение, Контакт, Бот);
	КонецЕсли;

	// Сначала обрабатываем переданный контакт: успешная авторизация уже заполнит получателя.
	ЗапроситьТелефонНепривязанногоКонтактаMAX(Контакт, Бот);

	ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Получено сообщение MAX'"));

КонецПроцедуры

Процедура ОбработатьЗапускБота(Обновление, Бот)

	User = ЗначениеСвойства(Обновление, "user");
	Контакт = ПолучитьКонтактПоUser(User, Бот);

	Если Контакт.Пустая() Тогда
		Возврат;
	КонецЕсли;

	УстановитьБлокировкуКонтакта(Контакт, Ложь);

	Если Не ЗначениеЗаполнено(Контакт.Получатель) Тогда
		ЗапроситьТелефонНепривязанногоКонтактаMAX(Контакт, Бот);
		ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Обработан запрос контакта MAX'"));

		Возврат;
	КонецЕсли;

	Сообщение = Новый Структура;
	Сообщение.Вставить("sender", User);
	Сообщение.Вставить("timestamp", ЗначениеСвойства(Обновление, "timestamp"));

	Payload = СтроковоеСвойство(Обновление, "payload");
	Сообщение.Вставить("body", Новый Структура("text, mid", "/start " + Payload, СтроковоеСвойство(Обновление,
		"timestamp")));

	ОбработатьКоманду(Сообщение, Контакт, Бот, "/start");

	ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Пользователь запустил бота MAX'"));

КонецПроцедуры

Процедура ОбработатьОстановкуБота(Обновление, Бот)

	Контакт = ПолучитьКонтактПоUser(ЗначениеСвойства(Обновление, "user"), Бот);
	Если Не Контакт.Пустая() Тогда
		УстановитьБлокировкуКонтакта(Контакт, Истина);
	КонецЕсли;

	ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Пользователь остановил бота MAX'"));

КонецПроцедуры

Процедура ОбработатьCallback(Обновление, Бот)

	Если ОбработатьВыборПациентаMAX(Обновление, Бот) Тогда
		Возврат;
	КонецЕсли;

	//+бит_Сафаров ШИ 01.09.2026
	Если бит_ОбработатьCallbackЗаявки(Обновление, Бот) Тогда
		Возврат;
	КонецЕсли;
	//-бит_Сафаров ШИ 01.09.2026

	Обработчик = бит_омни_ИнтеграцияСMAXПовтИсп.ОбработчикКоманды("callback");
	Если ПустаяСтрока(Обработчик) Тогда
		ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Callback MAX пропущен'"));
		Возврат;
	КонецЕсли;

	ВыполнитьОбработчик(Обработчик, Обновление, Справочники.бит_омни_Контакты.ПустаяСсылка(), Бот);

КонецПроцедуры

//+бит_Сафаров ШИ 01.09.2026
Функция бит_ОбработатьCallbackЗаявки(Обновление, Бот)

	Callback = ЗначениеСвойства(Обновление, "callback");
	Payload = СтроковоеСвойство(Callback, "payload");
	Префикс = "appointment_";
	Если Лев(Payload, СтрДлина(Префикс)) <> Префикс Тогда
		Возврат Ложь;
	КонецЕсли;

	CallbackId = СтроковоеСвойство(Callback, "callback_id");
	Если ПустаяСтрока(CallbackId) Тогда
		ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Callback MAX не содержит callback_id'"));
		Возврат Истина;
	КонецЕсли;

	СуффиксПодтверждения = "_confirm";
	СуффиксОтмены = "_cancel";
	Если Прав(Payload, СтрДлина(СуффиксПодтверждения)) = СуффиксПодтверждения Тогда
		Действие = "confirm";
		ДлинаСуффикса = СтрДлина(СуффиксПодтверждения);
	ИначеЕсли Прав(Payload, СтрДлина(СуффиксОтмены)) = СуффиксОтмены Тогда
		Действие = "cancel";
		ДлинаСуффикса = СтрДлина(СуффиксОтмены);
	Иначе
		ОтветитьНаCallbackMAX(CallbackId, Бот, "Неизвестная команда для записи.");
		Возврат Истина;
	КонецЕсли;

	ДлинаИдентификатора = СтрДлина(Payload) - СтрДлина(Префикс) - ДлинаСуффикса;
	Если ДлинаИдентификатора <= 0 Тогда
		ОтветитьНаCallbackMAX(CallbackId, Бот, "Не указан идентификатор записи.");
		Возврат Истина;
	КонецЕсли;

	ИдентификаторДокумента = Сред(Payload, СтрДлина(Префикс) + 1, ДлинаИдентификатора);
	Контакт = ПолучитьКонтактПоUser(ЗначениеСвойства(Callback, "user"), Бот);
	Если Контакт.Пустая()
		Или ТипЗнч(Контакт.Получатель) <> Тип("СправочникСсылка.Клиенты")
		Или Контакт.Получатель.Пустая()
	Тогда
		ОтветитьНаCallbackMAX(CallbackId, Бот, "Сначала авторизуйтесь в боте по номеру телефона.");
		Возврат Истина;
	КонецЕсли;

	Результат = ВыполнитьДействиеКонтактаMAX(CallbackId, ИдентификаторДокумента, Действие, Контакт, Бот);
	Если Результат.Повтор Тогда
		ОтветитьНаCallbackMAX(CallbackId, Бот, Результат.Сообщение);
		Возврат Истина;
	КонецЕсли;

	Если Результат.Успех Тогда
		ИсходноеСообщение = ЗначениеСвойства(Обновление, "message");
		НовыйТекст = ТекстСообщенияMAX(ИсходноеСообщение);
		Если СтрНайти(НовыйТекст, Результат.Сообщение) = 0 Тогда
			Если Не ПустаяСтрока(НовыйТекст) Тогда
				НовыйТекст = НовыйТекст + Символы.ПС + Символы.ПС;
			КонецЕсли;
			НовыйТекст = НовыйТекст + Результат.Сообщение;
		КонецЕсли;

		Вложения = ВложенияПослеДействияЗаписиMAX(ИсходноеСообщение, Действие);
		ОтветитьНаCallbackMAX(CallbackId, Бот, Результат.Сообщение, НовыйТекст, Вложения);
	Иначе
		ОтветитьНаCallbackMAX(CallbackId, Бот, Результат.Сообщение);
	КонецЕсли;

	ЗаписатьСобытиеВЖурнал(Обновление, Бот, СтрШаблон(
		"Callback MAX обработан: %1", Результат.Сообщение));
	Возврат Истина;

КонецФункции
//-бит_Сафаров ШИ 01.09.2026

Функция ВыполнитьДействиеКонтактаMAX(CallbackId, ИдентификаторДокумента, Действие, Контакт, Бот)

	// Хеш сохраняет полный callback_id без обрезания ключа регистра до 150 символов.
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(CallbackId);
	ИдентификаторСообщения = "callback:" + Base64Строка(Хеширование.ХешСумма);
	ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
	Если ДанныеБота = Неопределено Тогда
		Возврат Новый Структура("Успех, Сообщение, Повтор", Ложь, "Не найден бот MAX.", Ложь);
	КонецЕсли;

	// Действие и история фиксируются вместе; повторная доставка не меняет заявку повторно.
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.бит_омни_ИсторияЧатовMAX");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторСообщения", ИдентификаторСообщения);
		ЭлементБлокировки.УстановитьЗначение("Контакт", Контакт);
		ЭлементБлокировки.УстановитьЗначение("Бот", ДанныеБота.Ссылка);
		ЭлементБлокировки.УстановитьЗначение("Входящее", Истина);
		Блокировка.Заблокировать();

		Если СообщениеЧатаУжеЗаписаноMAX(ИдентификаторСообщения, Контакт, Бот, Истина) Тогда
			Результат = Новый Структура("Успех, Сообщение, Повтор", Истина, "Действие уже обработано.", Истина);
		Иначе
			Результат = Документы.Заявка.бит_ВыполнитьДействиеИзCallbackMAX(
				ИдентификаторДокумента, Действие, Контакт.Получатель);
			Результат.Вставить("Повтор", Ложь);
			ЗаписатьДействиеКонтактаMAX(ИдентификаторСообщения, Действие, Контакт, Бот, Результат);
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Результат;

КонецФункции

Процедура ЗаписатьДействиеКонтактаMAX(ИдентификаторСообщения, Действие, Контакт, Бот, Результат)

	НаименованиеКнопки = ?(Действие = "confirm", "Подтвердить запись", "Отменить запись");
	Текст = СтрШаблон("Нажата кнопка «%1».", НаименованиеКнопки) + Символы.ПС + Результат.Сообщение;
	ЗаписатьСообщениеЧатаMAX(
		ИдентификаторСообщения,
		Контакт,
		Бот,
		Истина,
		Текст,
		"contact_action",
		Строка(Контакт),
		"Получено",
		"",
		"",
		Перечисления.бит_омни_ВидыОтправителейMAX.Пациент);

КонецПроцедуры

Процедура ОбработатьСообщение(Сообщение, Контакт, Бот)

	ТелоСообщения = ЗначениеСвойства(Сообщение, "body");
	Вложения = ЗначениеСвойства(ТелоСообщения, "attachments");
	Если ТипЗнч(Вложения) = Тип("Массив") И Вложения.Количество() Тогда
		ПервоеВложение = Вложения.Получить(0);
		Если ПервоеВложение.type = "contact" Тогда
			ИнформацияОКонтакте = ЗначениеСвойства(ПервоеВложение, "payload");
			ОбработатьПолученныйКонтактMAX(ИнформацияОКонтакте, Контакт, Бот);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Обработчик = бит_омни_ИнтеграцияСMAXПовтИсп.ОбработчикСообщения();
	Если ПустаяСтрока(Обработчик) Тогда
		Возврат;
	КонецЕсли;

	ВыполнитьОбработчик(Обработчик, Сообщение, Контакт, Бот);

КонецПроцедуры

Процедура ОбработатьКоманду(Сообщение, Контакт, Бот, Команда, Параметры = Неопределено)

	ИмяКоманды = СокрЛП(Команда);
	Если Лев(ИмяКоманды, 1) = "/" Тогда
		ИмяКоманды = Сред(ИмяКоманды, 2);
	КонецЕсли;

	Если НРег(ИмяКоманды) = "patient" Тогда
		ПредложитьВыборПациентаMAX(Контакт, Бот);
		Возврат;
	КонецЕсли;

	ДействиеКоманды = РегистрыСведений.бит_омни_Команды.СоздатьМенеджерЗаписи();
	ДействиеКоманды.Команда = ИмяКоманды;
	ДействиеКоманды.Прочитать();

	Если ДействиеКоманды.Выбран() И Не ДействиеКоманды.Действие.Пустая() Тогда

		Результат = Справочники.бит_омни_Действия.ВыполнитьДействие(ДействиеКоманды.Действие, Сообщение.body.text,
			Контакт, Бот, Параметры);

		Если Не Результат.Ошибка Тогда
			Возврат;
		КонецЕсли;

		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Команды", УровеньЖурналаРегистрации.Ошибка, , ДействиеКоманды.Действие,
			Результат.Описание);

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отправляет запрос номера только до первой успешной отправки такому контакту от этого бота.
//
// Параметры:
//  Контакт - СправочникСсылка.бит_омни_Контакты - отправитель события MAX.
//  Бот - СправочникСсылка.бит_омни_Боты - бот, получивший событие.
//  Принудительно - Булево - повторить запрос по явной команде пользователя.
Процедура ЗапроситьТелефонНепривязанногоКонтактаMAX(Контакт, Бот, Принудительно = Ложь)

	Если Не ЗначениеЗаполнено(Контакт) Тогда
		Возврат;
	КонецЕсли;
	ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
	Если ДанныеБота = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		// Та же блокировка используется ручной привязкой в Едином чате.
		// Проверка и отправка сериализуются между параллельными событиями MAX.
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.бит_омни_Контакты");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Контакт);
		Блокировка.Заблокировать();

		КонтактОбъект = Контакт.ПолучитьОбъект();
		Если (Принудительно Или (Не ЗначениеЗаполнено(КонтактОбъект.Получатель)
			И ПустаяСтрока(КонтактОбъект.ТелефонMAX)))
			И Не КонтактОбъект.Заблокирован
			И Не КонтактОбъект.ПометкаУдаления
			И КонтактОбъект.Бот = ДанныеБота.Ссылка
			И (Принудительно Или Не ЗапросТелефонаУжеОтправленMAX(Контакт, ДанныеБота.Ссылка)) Тогда
			ПараметрыСообщения = ПараметрыЗапросаТелефонаMAX(Контакт, ДанныеБота);
			ОтправитьСообщение(ПараметрыСообщения, Контакт, ДанныеБота.Ссылка);
		КонецЕсли;

		// Неуспешная отправка сохраняется с ошибкой и допускает новую попытку при следующем сообщении.
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.ЗапросТелефона", УровеньЖурналаРегистрации.Ошибка, , Контакт,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция ЗапросТелефонаУжеОтправленMAX(Контакт, Бот)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		| История.ДанныеВложений КАК ДанныеВложений
		|ИЗ
		| РегистрСведений.бит_омни_ИсторияЧатовMAX КАК История
		|ГДЕ
		| История.Контакт = &Контакт
		| И История.Бот = &Бот
		| И НЕ История.Входящее
		| И История.Статус = &Статус";
	Запрос.УстановитьПараметр("Контакт", Контакт);
	Запрос.УстановитьПараметр("Бот", Бот);
	Запрос.УстановитьПараметр("Статус", "Отправлено");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПустаяСтрока(Выборка.ДанныеВложений) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Вложения = JSONВСтруктуру(Выборка.ДанныеВложений);
		Исключение
			ЗаписьЖурналаРегистрации("ОМНИ.MAX.ЗапросТелефона", УровеньЖурналаРегистрации.Предупреждение,
				, Контакт, "Не удалось прочитать вложения исходящего сообщения: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Если ВложенияСодержатЗапросТелефонаMAX(Вложения) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ВложенияСодержатЗапросТелефонаMAX(Вложения)

	Если ТипЗнч(Вложения) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Вложение Из Вложения Цикл
		Если СтроковоеСвойство(Вложение, "type") <> "inline_keyboard" Тогда
			Продолжить;
		КонецЕсли;
		Ряды = ЗначениеСвойства(ЗначениеСвойства(Вложение, "payload"), "buttons");
		Если ТипЗнч(Ряды) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ряд Из Ряды Цикл
			Если ТипЗнч(Ряд) <> Тип("Массив") Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Кнопка Из Ряд Цикл
				Если СтроковоеСвойство(Кнопка, "type") = "request_contact" Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПараметрыЗапросаТелефонаMAX(Контакт, ДанныеБота)

	Шаблон = Справочники.бит_омни_ШаблоныСообщений.СтандартныйШаблон("MAX_WELCOME");
	Если Не Шаблон.Пустая() Тогда
		Параметры = ПараметрыСообщенияMAX(Шаблон, Контакт, Неопределено, ДанныеБота);
		Если ВложенияСодержатЗапросТелефонаMAX(ЗначениеСвойства(Параметры, "attachments")) Тогда
			Возврат Параметры;
		КонецЕсли;
	КонецЕсли;

	// Отсутствующий или изменённый шаблон не должен оставлять пользователя без кнопки запроса номера.
	Ряд = Новый Массив;
	Ряд.Добавить(Новый Структура("type, text", "request_contact", "Отправить контакт"));
	Ряды = Новый Массив;
	Ряды.Добавить(Ряд);
	Вложения = Новый Массив;
	Вложения.Добавить(Новый Структура("type, payload", "inline_keyboard", Новый Структура("buttons", Ряды)));
	Возврат Новый Структура("text, attachments",
		"Здравствуйте! Чтобы связать переписку с вашей карточкой пациента, отправьте номер телефона вашего аккаунта MAX.",
		Вложения);

КонецФункции

Функция ЗаголовкиMAX(Токен)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", Токен);

	Возврат Заголовки;

КонецФункции

Функция ПрочитатьОтветMAX(Ответ)

	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
	ТелоОтвета = Неопределено;

	Если Не ПустаяСтрока(ТекстОтвета) Тогда
		Попытка
			ТелоОтвета = JSONВСтруктуру(ТекстОтвета);
		Исключение
			ТелоОтвета = Новый Структура("raw", ТекстОтвета);
		КонецПопытки;
	КонецЕсли;

	Возврат Новый Структура("Текст, Тело", ТекстОтвета, ТелоОтвета);

КонецФункции


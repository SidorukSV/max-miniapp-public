	//+бит_Сафаров ШИ 19.08.2026
	//+бит.Сидорук С.В. 14.10.2026
	//БЫЛО
	//Если ТипЗнч(Источник) = Тип("ДокументОбъект.Заявка")
	//	И Источник.ДополнительныеСвойства.Свойство("бит_омни_НоваяЗаявка")
	//	И Источник.ДополнительныеСвойства.бит_омни_НоваяЗаявка Тогда
	//	бит_омни_РассылкиMAXСервер.бит_ПоставитьЗапросПодтвержденияВОчередь(Источник.Ссылка);
	//КонецЕсли;
	//Если ТипЗнч(Источник) = Тип("ДокументОбъект.Заявка")
	//	И Источник.ДополнительныеСвойства.Свойство("бит_омни_ПодтвержденаПриСоздании")
	//	И Источник.ДополнительныеСвойства.бит_омни_ПодтвержденаПриСоздании Тогда
	//	бит_омни_РассылкиMAXСервер.бит_ПоставитьПодтверждениеВОчередь(Источник.Ссылка);
	//КонецЕсли;
	//СТАЛО
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.Заявка") Тогда
		бит_ЗаписатьАвтоподтверждениеСегодняMAX(Источник);
		Если Источник.ДополнительныеСвойства.Свойство("бит_ИзмененаДатаЗаписиMAX")
			И Источник.ДополнительныеСвойства.бит_ИзмененаДатаЗаписиMAX Тогда
			бит_омни_РассылкиMAXСервер.бит_ПоставитьУведомлениеОЗаписиВОчередь(Источник.Ссылка);
			бит_омни_РассылкиMAXСервер.бит_ПоставитьЗапросПодтвержденияВОчередь(Источник.Ссылка);
		КонецЕсли;
	КонецЕсли;
	//-бит.Сидорук С.В. 14.10.2026

	//-бит_Сафаров ШИ 19.08.2026
	//+бит_Сафаров ШИ 16.09.2026
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.Заявка")
		И Источник.ДополнительныеСвойства.Свойство("бит_омни_ОтмененаПриЗаписи")
		И Источник.ДополнительныеСвойства.бит_омни_ОтмененаПриЗаписи Тогда
		бит_омни_РассылкиMAXСервер.бит_ПоставитьОтменуВОчередь(Источник.Ссылка);
	КонецЕсли;
	//-бит_Сафаров ШИ 16.09.2026

	Если Источник.ДополнительныеСвойства.Свойство("бит_омни_Рассылки") Тогда

		Рассылки = Источник.ДополнительныеСвойства.бит_омни_Рассылки;

		МодульСхемыКомпоновки = ОбщегоНазначения.ОбщийМодуль("бит_омни_СхемыКомпоновки");

		Для Каждого Рассылка Из Рассылки Цикл

			НоваяЗапись = Рассылка.ПриЗаписи.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, Источник);

			ТаблицаОбъединения = Новый ТаблицаЗначений;
			ТаблицаОбъединения = Рассылка.ПередЗаписью.Скопировать();

			Для Каждого Колонка Из ТаблицаОбъединения.Колонки Цикл
				Колонка.Имя = Колонка.Имя + "До";
			КонецЦикла;

			Для Каждого Колонка Из Рассылка.ПриЗаписи.Колонки Цикл
				ТаблицаОбъединения.Колонки.Добавить(Колонка.Имя + "После", Колонка.ТипЗначения);
				ТаблицаОбъединения[0][Колонка.Имя + "После"] = НоваяЗапись[Колонка.Имя];
			КонецЦикла;

			СКДКонтекст = Рассылка.СКДКонтекст.ХранилищеСКД.Получить();
			СКДПолучатели = Рассылка.СКДПолучатели.ХранилищеСКД.Получить();
			НаборДанныхОбъединенный = СКДКонтекст.НаборыДанных.Найти("НаборДанныхОбъединенный");

			Если НаборДанныхОбъединенный = Неопределено Тогда
				НаборДанныхОбъединенный = СКДКонтекст.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
			КонецЕсли;

			НаборДанныхОбъединенный.Имя = "НаборДанныхОбъединенный";
			НаборДанныхОбъединенный.ИмяОбъекта = "НаборДанныхОбъединенный";
			НаборДанныхОбъединенный.ИсточникДанных = "ИсточникДанных1";

			Для Каждого Колонка Из ТаблицаОбъединения.Колонки Цикл

				Если НаборДанныхОбъединенный.Поля.Найти(Колонка.Имя) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;

				Если Колонка.ТипЗначения = Тип("ТаблицаЗначений") Тогда
					Поле = НаборДанныхОбъединенный.Поля.Добавить(Тип("ВложенныйНаборДанныхСхемыКомпоновкиДанных"));
				Иначе
					Поле = НаборДанныхОбъединенный.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
					Поле.ТипЗначения = Колонка.ТипЗначения;
				КонецЕсли;

				Поле.Поле = Колонка.Имя;
				Поле.ПутьКДанным = Колонка.Имя;
				Поле.Заголовок = Колонка.Заголовок;

			КонецЦикла;

			НДПередЗаписью = СКДКонтекст.НаборыДанных.Найти("ПередЗаписью");
			НДПриЗаписи = СКДКонтекст.НаборыДанных.Найти("ПриЗаписи");

			Если НДПередЗаписью <> Неопределено Тогда
				СКДКонтекст.НаборыДанных.Удалить(НДПередЗаписью);
			КонецЕсли;

			Если НДПриЗаписи <> Неопределено Тогда
				СКДКонтекст.НаборыДанных.Удалить(НДПриЗаписи);
			КонецЕсли;

			ПараметрыВыполнения = МодульСхемыКомпоновки.ПараметрыВыполненияСхемы("ТаблицаЗначений");
			ДобавитьВнешниеНаборыДанныхРассылки(ПараметрыВыполнения, СКДКонтекст, ТаблицаОбъединения);
			ДобавитьВнешниеНаборыДанныхРассылки(ПараметрыВыполнения, СКДПолучатели, ТаблицаОбъединения);

			Контекст = МодульСхемыКомпоновки.ВыполнитьСхему(СКДКонтекст, ПараметрыВыполнения);
			ПолучателиТЗ = МодульСхемыКомпоновки.ВыполнитьСхему(СКДПолучатели, ПараметрыВыполнения);
			Получатели = ПолучателиТЗ.ВыгрузитьКолонку("Получатель");

			Если Контекст.Количество() > 0  Тогда
				бит_омни_ИнтеграцияСMAX.ОтправитьСообщение(Рассылка.Шаблон, Получатели, Рассылка.Бот, Контекст[0]);
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

КонецПроцедуры

Процедура ДокументыПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	//+бит.Сидорук С.В. 14.10.2026
	// Объект документа может повторно записываться в том же сеансе.
	Источник.ДополнительныеСвойства.Удалить("бит_АвтоподтверждениеСегодняMAX");
	//-бит.Сидорук С.В. 14.10.2026

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Источник.ДополнительныеСвойства.Свойство("бит_омни_НеПроверять") Тогда
		Возврат;
	КонецЕсли;

	//+бит_Сафаров ШИ 19.08.2026
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.Заявка") Тогда
		НоваяЗаявка = Источник.Ссылка.Пустая();
		Источник.ДополнительныеСвойства.Вставить("бит_омни_НоваяЗаявка", НоваяЗаявка);
		//+бит.Сидорук С.В. 14.10.2026
		ДатаИзменена = НоваяЗаявка;
		Если Не НоваяЗаявка Тогда
			ДатаИзменена = Источник.ДатаНачала <> ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				Источник.Ссылка, "ДатаНачала");
		КонецЕсли;
		Источник.ДополнительныеСвойства.Вставить("бит_ИзмененаДатаЗаписиMAX", ДатаИзменена);
		бит_ПодготовитьАвтоподтверждениеСегодняMAX(Источник, ДатаИзменена);
		//-бит.Сидорук С.В. 14.10.2026

		//+бит_Сафаров ШИ 16.09.2026
		Если Не НоваяЗаявка
			И Источник.Состояние.ТипСостояния = Перечисления.ТипыСостоянийЗаявок.Отменена Тогда
			СостояниеДоОтмены = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				Источник.Ссылка, "Состояние");
			Источник.ДополнительныеСвойства.Вставить("бит_омни_ОтмененаПриЗаписи",
				СостояниеДоОтмены.ТипСостояния <> Перечисления.ТипыСостоянийЗаявок.Отменена);
		КонецЕсли;
		//-бит_Сафаров ШИ 16.09.2026

		ПризнакПодтвержденнойЗаявки =
			УправлениеНастройками.ПолучитьПараметрУчетнойПолитики("ПризнакПодтвержденнойЗаявки");
		Если ТипЗнч(ПризнакПодтвержденнойЗаявки) = Тип("СправочникСсылка.ВидыСостоянийЗаявок")
			И Источник.Состояние = ПризнакПодтвержденнойЗаявки Тогда
			Источник.ДополнительныеСвойства.Вставить("бит_омни_ПодтвержденаПриСоздании", НоваяЗаявка);

			СостояниеДоЗаписи = ?(
				НоваяЗаявка,
				Справочники.ВидыСостоянийЗаявок.ПустаяСсылка(),
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "Состояние"));
			//+бит.Сидорук С.В. 14.10.2026
			//БЫЛО
			//Если СостояниеДоЗаписи <> ПризнакПодтвержденнойЗаявки Тогда
			//СТАЛО
			Если СостояниеДоЗаписи <> ПризнакПодтвержденнойЗаявки
				И Не НоваяЗаявка
				И Не Источник.ДополнительныеСвойства.Свойство("бит_АвтоподтверждениеСегодняMAX") Тогда
			//-бит.Сидорук С.В. 14.10.2026

				бит_омни_РассылкиMAXСервер.бит_ПоставитьПодтверждениеВОчередь(Источник.Ссылка);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//-бит_Сафаров ШИ 19.08.2026

	Рассылки = ПроверитьРассылки(Источник);

	Если Рассылки <> Неопределено Тогда

		Для Каждого Рассылка Из Рассылки Цикл
			НоваяЗапись = Рассылка.ПередЗаписью.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, Источник.Ссылка);
		КонецЦикла;

		Источник.ДополнительныеСвойства.Вставить("бит_омни_Рассылки", Рассылки);

	КонецЕсли;

КонецПроцедуры

//+бит_Сафаров ШИ 19.08.2026
Процедура бит_омни_ЗначенияСвойствПередЗаписью(Источник, Отказ, Замещение) Экспорт

	//+бит.Сидорук С.В. 14.10.2026
	Если Источник.ДополнительныеСвойства.Свойство("бит_АвтоподтверждениеСегодняMAX") Тогда
		Возврат;
	КонецЕсли;
	//-бит.Сидорук С.В. 14.10.2026

	Если Источник.Метаданные() <> Метаданные.РегистрыСведений.ЗначенияСвойствОбъектов Тогда
		Возврат;
	КонецЕсли;

	ПризнакПодтвержденнойЗаявки =
		УправлениеНастройками.ПолучитьПараметрУчетнойПолитики("ПризнакПодтвержденнойЗаявки");
	Если Не ЗначениеЗаполнено(ПризнакПодтвержденнойЗаявки)
		Или ТипЗнч(ПризнакПодтвержденнойЗаявки) = Тип("СправочникСсылка.ВидыСостоянийЗаявок") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаЗначения Из Источник Цикл
		Если СтрокаЗначения.Свойство <> ПризнакПодтвержденнойЗаявки
			Или ТипЗнч(СтрокаЗначения.Объект) <> Тип("ДокументСсылка.Заявка")
			Или СтрокаЗначения.Значение <> Истина Тогда
			Продолжить;
		КонецЕсли;

		Если Не бит_омни_ЗначениеПодтвержденияДоЗаписи(
			СтрокаЗначения.Объект,
			СтрокаЗначения.Свойство) Тогда
			бит_омни_РассылкиMAXСервер.бит_ПоставитьПодтверждениеВОчередь(СтрокаЗначения.Объект);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
//-бит_Сафаров ШИ 19.08.2026

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//+бит_Сафаров ШИ 19.08.2026
Функция бит_омни_ЗначениеПодтвержденияДоЗаписи(Заявка, Свойство)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗначенияСвойств.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойств
	|ГДЕ
	|	ЗначенияСвойств.Объект = &Заявка
	|	И ЗначенияСвойств.Свойство = &Свойство";
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Запрос.УстановитьПараметр("Свойство", Свойство);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий() И Выборка.Значение = Истина;

КонецФункции
//-бит_Сафаров ШИ 19.08.2026


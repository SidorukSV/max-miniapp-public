КонецПроцедуры

Процедура бит_ПодготовитьАвтоподтверждениеСегодняMAX(Источник, ДатаИзменена)
	//+бит.Сидорук С.В. 14.10.2026
	Если Не ДатаИзменена Или Источник.ПометкаУдаления
		Или Источник.ДатаНачала <= ТекущаяДатаСеанса()
		Или НачалоДня(Источник.ДатаНачала) <> НачалоДня(ТекущаяДатаСеанса())
		Или Источник.Состояние.ТипСостояния = Перечисления.ТипыСостоянийЗаявок.Отменена
		Или Не бит_омни_РассылкиMAXСервер.бит_ЕстьАктивныеРассылкиЗаписейMAX() Тогда
		Возврат;
	КонецЕсли;
	ПризнакПодтверждения = УправлениеНастройками.ПолучитьПараметрУчетнойПолитики(
		"ПризнакПодтвержденнойЗаявки");
	Если Не ЗначениеЗаполнено(ПризнакПодтверждения) Тогда
		ВызватьИсключение "Для автоматического подтверждения записи на сегодня настройте признак подтвержденной заявки.";
	КонецЕсли;
	Источник.ДополнительныеСвойства.Вставить("бит_АвтоподтверждениеСегодняMAX", ПризнакПодтверждения);
	Если ТипЗнч(ПризнакПодтверждения) = Тип("СправочникСсылка.ВидыСостоянийЗаявок") Тогда
		Источник.Состояние = ПризнакПодтверждения;
	КонецЕсли;
	//-бит.Сидорук С.В. 14.10.2026

КонецПроцедуры

Процедура бит_ЗаписатьАвтоподтверждениеСегодняMAX(Источник)
	//+бит.Сидорук С.В. 14.10.2026
	ПризнакПодтверждения = Неопределено;
	Если Не Источник.ДополнительныеСвойства.Свойство(
		"бит_АвтоподтверждениеСегодняMAX", ПризнакПодтверждения)
		Или ТипЗнч(ПризнакПодтверждения) = Тип("СправочникСсылка.ВидыСостоянийЗаявок") Тогда
		Возврат;
	КонецЕсли;
	// То же хранилище подтверждения, что использует штатное подтверждение записи.
	Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Источник.Ссылка);
	Набор.Отбор.Свойство.Установить(ПризнакПодтверждения);
	Набор.Прочитать();
	Набор.Очистить();
	Запись = Набор.Добавить();
	Запись.Объект = Источник.Ссылка;
	Запись.Свойство = ПризнакПодтверждения;
	Запись.Значение = Истина;
	Набор.ДополнительныеСвойства.Вставить("бит_АвтоподтверждениеСегодняMAX", Истина);
	Набор.Записать();
	//-бит.Сидорук С.В. 14.10.2026

КонецПроцедуры

Функция ПроверитьРассылки(Источник)

	МетаОбъекта = Источник.Метаданные();
	ИмяОбъекта = МетаОбъекта.ПолноеИмя();

	//+бит_Сафаров ШИ 19.08.2026
	Попытка
		ХранилищеКеша = ПараметрыСеанса.бит_омни_КешОбъектовДляРассылки;
	Исключение
		ХранилищеКеша = Неопределено;
	КонецПопытки;

	Если ХранилищеКеша = Неопределено Тогда
		Кеш = бит_омни_ОбщегоНазначения.ПолучитьСписокОбъектовДляРассылок();
		ХранилищеКеша = Новый ХранилищеЗначения(Кеш);
		ПараметрыСеанса.бит_омни_КешОбъектовДляРассылки = ХранилищеКеша;
	Иначе
		Кеш = ХранилищеКеша.Получить();
	КонецЕсли;
	//-бит_Сафаров ШИ 19.08.2026

	Возврат Кеш.Получить(ИмяОбъекта);

КонецФункции

Процедура ДобавитьВнешниеНаборыДанныхРассылки(
	ПараметрыВыполнения, СхемаКомпоновки, ТаблицаОбъединения)

	ПараметрыВыполнения.ВнешниеНаборыДанных.Вставить("НаборДанныхОбъединенный", ТаблицаОбъединения);

	Для Каждого НаборДанных Из СхемаКомпоновки.НаборыДанных Цикл

		Если ТипЗнч(НаборДанных) <> Тип("НаборДанныхОбъектСхемыКомпоновкиДанных")
				ИЛИ НЕ ЗначениеЗаполнено(НаборДанных.ИмяОбъекта) Тогда

			Продолжить;

		КонецЕсли;

		ОбеспечитьПоляВнешнегоНабораДанных(НаборДанных, ТаблицаОбъединения);

		ПараметрыВыполнения.ВнешниеНаборыДанных.Вставить(НаборДанных.ИмяОбъекта, ТаблицаОбъединения);

	КонецЦикла;

КонецПроцедуры

Процедура ОбеспечитьПоляВнешнегоНабораДанных(
	НаборДанных, ТаблицаОбъединения)

	Для Каждого Колонка Из ТаблицаОбъединения.Колонки Цикл
		ДобавитьПолеВнешнегоНабораДанныхЕслиОтсутствует(НаборДанных, Колонка.Имя, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;

	// Совместимость со схемами стандартных рассылок, созданными ранними
	// версиями расширения: настройки могли ссылаться на псевдоним, которого
	// не было в списке полей объектного набора данных.
	СоответствияПолей = Новый Соответствие;
	СоответствияПолей.Вставить("Получатель", "КлиентПосле");
	СоответствияПолей.Вставить("ЗаписьИзБота", "бит_омни_ЗаписьИзБотаПосле");
	СоответствияПолей.Вставить("appointment_id", "СсылкаПосле");
	СоответствияПолей.Вставить("appointment_date", "ДатаНачалаПосле");
	СоответствияПолей.Вставить("appointment_time", "ДатаНачалаПосле");
	СоответствияПолей.Вставить("doctor", "СотрудникПосле");
	СоответствияПолей.Вставить("address", "ФилиалПосле");

	Для Каждого СоответствиеПоля Из СоответствияПолей Цикл

		Колонка = ТаблицаОбъединения.Колонки.Найти(СоответствиеПоля.Значение);

		Если Колонка = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ДобавитьПолеВнешнегоНабораДанныхЕслиОтсутствует(НаборДанных, СоответствиеПоля.Ключ, СоответствиеПоля.Значение, Колонка.ТипЗначения);

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПолеВнешнегоНабораДанныхЕслиОтсутствует(
	НаборДанных, ИмяПоля, ПутьКДанным, ТипЗначения)

	Для Каждого СуществующееПоле Из НаборДанных.Поля Цикл

		Если СуществующееПоле.ПутьКДанным = ИмяПоля Тогда
			Возврат;
		КонецЕсли;

		// В ранних версиях стандартных рассылок источник и псевдоним
		// записывались наоборот. Исправляем такое поле без удаления
		// пользовательских настроек, которые ссылаются на псевдоним.
		Если СуществующееПоле.Поле = ИмяПоля
				И СуществующееПоле.ПутьКДанным = ПутьКДанным Тогда

			СуществующееПоле.Поле = ПутьКДанным;
			СуществующееПоле.ПутьКДанным = ИмяПоля;

			Если ТипЗнч(СуществующееПоле) = Тип("ПолеНабораДанныхСхемыКомпоновкиДанных") Тогда
				СуществующееПоле.ТипЗначения = ТипЗначения;
			КонецЕсли;

			Возврат;

		КонецЕсли;

	КонецЦикла;

	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Поле = НаборДанных.Поля.Добавить(Тип("ВложенныйНаборДанныхСхемыКомпоновкиДанных"));
	Иначе
		Поле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		Поле.ТипЗначения = ТипЗначения;
	КонецЕсли;

	Поле.Поле = ПутьКДанным;
	Поле.ПутьКДанным = ИмяПоля;
	Поле.Заголовок = ИмяПоля;

КонецПроцедуры

#КонецОбласти




//+бит_Сафаров ШИ 16.09.2026
Процедура бит_ПоставитьСобытиеВОчередь(Заявка, ИдентификаторСценария, ДатаВыполнения,
	ДатаЗаписи = Неопределено, Бот = Неопределено)
//-бит_Сафаров ШИ 16.09.2026

	ДанныеЗаявки = бит_ДанныеЗаявки(Заявка);
	Если ДанныеЗаявки = Неопределено Или Не ЗначениеЗаполнено(ДанныеЗаявки.Клиент) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СтандартныеРассылки.Бот КАК Бот,
	|	СтандартныеРассылки.Рассылка КАК Рассылка
	|ИЗ
	|	РегистрСведений.бит_омни_СтандартныеРассылкиMAX КАК СтандартныеРассылки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_омни_АктивныеРассылки КАК АктивныеРассылки
	|		ПО СтандартныеРассылки.Бот = АктивныеРассылки.Бот
	|			И СтандартныеРассылки.Рассылка = АктивныеРассылки.Рассылка
	|ГДЕ
	|	СтандартныеРассылки.ИдентификаторСценария = &ИдентификаторСценария
	|	И НЕ СтандартныеРассылки.Рассылка.ПометкаУдаления
	|	И СтандартныеРассылки.Бот.Использовать";
	Запрос.УстановитьПараметр("ИдентификаторСценария", ИдентификаторСценария);
	//+бит_Сафаров ШИ 16.09.2026
	Если ЗначениеЗаполнено(Бот) Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС + "| И СтандартныеРассылки.Бот = &Бот";
		Запрос.УстановитьПараметр("Бот", Бот);
	КонецЕсли;
	//-бит_Сафаров ШИ 16.09.2026

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		КлючСобытия = бит_КлючСобытия(ИдентификаторСценария, Заявка, ДатаЗаписи);
		Если бит_СтрокаОчередиСуществует(Выборка.Бот, КлючСобытия) Тогда
			Продолжить;
		КонецЕсли;

		ЗаписьОчереди = РегистрыСведений.бит_омни_ОчередьРассылокMAX.СоздатьМенеджерЗаписи();
		ЗаписьОчереди.Бот = Выборка.Бот;
		ЗаписьОчереди.КлючСобытия = КлючСобытия;
		ЗаписьОчереди.ИдентификаторСценария = ИдентификаторСценария;
		ЗаписьОчереди.Рассылка = Выборка.Рассылка;
		ЗаписьОчереди.Заявка = Заявка;
		ЗаписьОчереди.Клиент = ДанныеЗаявки.Клиент;
		ЗаписьОчереди.ДатаВыполнения = ДатаВыполнения;
		ЗаписьОчереди.ДатаЗаписи = ?(ДатаЗаписи = Неопределено, ДанныеЗаявки.ДатаНачала, ДатаЗаписи);
		ЗаписьОчереди.Статус = "Ожидает";
		ЗаписьОчереди.КоличествоПопыток = 0;
		ЗаписьОчереди.Записать();
	КонецЦикла;

КонецПроцедуры

Процедура бит_СформироватьОчередьНапоминаний()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СтандартныеРассылки.Бот КАК Бот,
	|	СтандартныеРассылки.Рассылка КАК Рассылка,
	|	СтандартныеРассылки.Рассылка.Расписание КАК Расписание,
	|	АктивныеРассылки.ДатаНачалаПоследнегоЗапуска КАК ДатаНачалаПоследнегоЗапуска,
	|	АктивныеРассылки.ДатаЗавершенияПоследнегоЗапуска КАК ДатаЗавершенияПоследнегоЗапуска
	|ИЗ
	|	РегистрСведений.бит_омни_СтандартныеРассылкиMAX КАК СтандартныеРассылки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_омни_АктивныеРассылки КАК АктивныеРассылки
	|		ПО СтандартныеРассылки.Бот = АктивныеРассылки.Бот
	|			И СтандартныеРассылки.Рассылка = АктивныеРассылки.Рассылка
	|ГДЕ
	|	СтандартныеРассылки.ИдентификаторСценария = &ИдентификаторСценария
	|	И НЕ СтандартныеРассылки.Рассылка.ПометкаУдаления
	|	И СтандартныеРассылки.Бот.Использовать";
	Запрос.УстановитьПараметр("ИдентификаторСценария", "MAX_APPOINTMENT_REMINDER");

	ТекущаяДата = ТекущаяДатаСеанса();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Расписание = Выборка.Расписание.Получить();
		Если ТипЗнч(Расписание) <> Тип("РасписаниеРегламентногоЗадания") Тогда
			Продолжить;
		КонецЕсли;

		Если Не Расписание.ТребуетсяВыполнение(
			ТекущаяДата,
			Выборка.ДатаНачалаПоследнегоЗапуска,
			Выборка.ДатаЗавершенияПоследнегоЗапуска) Тогда
			Продолжить;
		КонецЕсли;

		бит_ОтметитьНачалоРассылки(Выборка.Бот, Выборка.Рассылка, ТекущаяДата);

		//+бит_Сафаров ШИ 01.09.2026
		ИнтервалыНапоминаний = бит_ИнтервалыНапоминаний(Выборка.Бот);
		МаксимальныйИнтервал = 0;
		Для Каждого ЧасовДоПриема Из ИнтервалыНапоминаний Цикл
			Если ЧасовДоПриема > МаксимальныйИнтервал Тогда
				МаксимальныйИнтервал = ЧасовДоПриема;
			КонецЕсли;
		КонецЦикла;
		Если МаксимальныйИнтервал = 0 Тогда
			бит_ОтметитьЗавершениеРассылки(Выборка.Бот, Выборка.Рассылка, ТекущаяДатаСеанса());
			Продолжить;
		КонецЕсли;
		ДатаНачалаОкна = ТекущаяДата;
		ДатаОкончанияОкна = ТекущаяДата + МаксимальныйИнтервал * 3600;
		//-бит_Сафаров ШИ 01.09.2026

		бит_ПоставитьНапоминанияВОчередь(
			Выборка.Бот,
			Выборка.Рассылка,
			ДатаНачалаОкна,
			ДатаОкончанияОкна,
			ИнтервалыНапоминаний);

		бит_ОтметитьЗавершениеРассылки(Выборка.Бот, Выборка.Рассылка, ТекущаяДатаСеанса());

	КонецЦикла;

КонецПроцедуры

Процедура бит_ПоставитьНапоминанияВОчередь(Бот, Рассылка, ДатаНачалаОкна, ДатаОкончанияОкна, ИнтервалыНапоминаний)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Заявка.Ссылка КАК Заявка,
	|	Заявка.Клиент КАК Клиент,
	|	Заявка.ДатаНачала КАК ДатаНачала
	|ИЗ
	|	Документ.Заявка КАК Заявка
	|ГДЕ

	Если ЗначениеЗаполнено(ДатаЗаписи) И ИдентификаторСценария = "MAX_APPOINTMENT_REMINDER" Тогда
		Ключ = Ключ + ":" + Формат(ДатаЗаписи, "ДФ=yyyyMMddHHmmss");
	КонецЕсли;
	Возврат Ключ;


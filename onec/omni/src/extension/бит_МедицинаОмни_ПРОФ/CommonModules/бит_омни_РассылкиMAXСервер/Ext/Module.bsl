КонецПроцедуры

Процедура бит_ОбработатьСтрокуОчереди(Бот, КлючСобытия)

	ЗаписьОчереди = РегистрыСведений.бит_омни_ОчередьРассылокMAX.СоздатьМенеджерЗаписи();
	ЗаписьОчереди.Бот = Бот;
	ЗаписьОчереди.КлючСобытия = КлючСобытия;
	ЗаписьОчереди.Прочитать();

	//+бит.Сидорук С.В. 14.10.2026
	// Старые немедленные запросы имеют ключ без даты; новый цикл создается отдельно.
	Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CONFIRM_REQUEST"
		И КлючСобытия = бит_КлючСобытия("MAX_APPOINTMENT_CONFIRM_REQUEST", ЗаписьОчереди.Заявка, Неопределено) Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Устаревший немедленный запрос подтверждения.");
		Возврат;
	КонецЕсли;
	Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_REMINDER"
		И ЗаписьОчереди.ИнтервалНапоминанияЧасов = 24 Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Запрос за сутки отправляется отдельным сценарием.");
		Возврат;
	КонецЕсли;
	//-бит.Сидорук С.В. 14.10.2026

	ДанныеЗаявки = бит_ДанныеЗаявки(ЗаписьОчереди.Заявка);
	//+бит_Сафаров ШИ 16.09.2026
	Если ДанныеЗаявки = Неопределено
		Или (ДанныеЗаявки.Отменена
			И ЗаписьОчереди.ИдентификаторСценария <> "MAX_APPOINTMENT_CANCELLED") Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Заявка отсутствует, удалена или отменена.");
		Возврат;
	КонецЕсли;
	Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CANCELLED"
		И Не ДанныеЗаявки.Отменена Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Отмена заявки не подтверждена.");
		Возврат;
	КонецЕсли;
	Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_DEBT"
		И бит_ДолгКлиента(ДанныеЗаявки.Клиент) <= 0 Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Задолженность отсутствует.");
		Возврат;
	КонецЕсли;
	//-бит_Сафаров ШИ 16.09.2026
	//+бит_Сафаров ШИ 04.09.2026
	Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_NO_RESPONSE" Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Устаревший контроль отсутствия ответа.");
		Возврат;
	КонецЕсли;
	Если ЗаписьОчереди.ИдентификаторСценария = "MAX_CONFIRMATION_NO_RESPONSE" Тогда
		Если ЗаписьОчереди.ДатаЗаписи <> ДанныеЗаявки.ДатаНачала Тогда
			бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Дата приема была изменена.");
			Возврат;
		КонецЕсли;
		бит_ОбработатьОтсутствиеОтвета(ЗаписьОчереди);
		Возврат;
	КонецЕсли;
	//-бит_Сафаров ШИ 04.09.2026

	//+бит.Сидорук С.В. 14.10.2026
	Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CREATED"
		Или ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CONFIRM_REQUEST" Тогда
		Если ЗаписьОчереди.ДатаЗаписи <> ДанныеЗаявки.ДатаНачала
			Или ДанныеЗаявки.ДатаНачала <= ТекущаяДатаСеанса() Тогда
			бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Время приема изменено или прием уже начался.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CONFIRM_REQUEST" Тогда
		ДатаЗапроса = бит_ДатаЗапросаПодтвержденияMAX(ДанныеЗаявки.ДатаНачала, ТекущаяДатаСеанса());
		Если ДатаЗапроса = Неопределено Тогда
			бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Для приема сегодня запрос подтверждения не отправляется.");
			Возврат;
		ИначеЕсли ДатаЗапроса > ТекущаяДатаСеанса() Тогда
			ЗаписьОчереди.ДатаВыполнения = ДатаЗапроса;
			ЗаписьОчереди.Статус = "Ожидает";
			ЗаписьОчереди.Записать();
			Возврат;
		КонецЕсли;
	КонецЕсли;
	//-бит.Сидорук С.В. 14.10.2026

	Если Не бит_РассылкаАктивна(ЗаписьОчереди.Бот, ЗаписьОчереди.Рассылка) Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Рассылка отключена для бота.");
		Возврат;
	КонецЕсли;

	//+бит_Сафаров ШИ 01.09.2026
	Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_REMINDER" Тогда
		Если ЗаписьОчереди.ИнтервалНапоминанияЧасов <= 0 Тогда
			бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Устаревшая запись очереди напоминаний.");
			Возврат;
		КонецЕсли;
		Если ЗаписьОчереди.ДатаЗаписи <> ДанныеЗаявки.ДатаНачала Тогда
			бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Дата приема была изменена.");
			Возврат;
		КонецЕсли;
		Если Не бит_ИнтервалНапоминанияАктивен(
			ЗаписьОчереди.Бот,
			ЗаписьОчереди.ИнтервалНапоминанияЧасов) Тогда
			бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Интервал напоминания отключен.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	//-бит_Сафаров ШИ 01.09.2026

	Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CONFIRM_REQUEST"
		И бит_ЗаявкаПодтверждена(ЗаписьОчереди.Заявка) Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Заявка уже подтверждена.");
		Возврат;
	КонецЕсли;
	//+бит_Сафаров ШИ 04.09.2026
	Если (ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CONFIRM_REQUEST"
		Или ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_REMINDER")
		И бит_ЗаявкаИмеетСтатусНеподтвержденной(ЗаписьОчереди.Заявка) Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Заявка уже помечена как неподтвержденная.");
		Возврат;
	КонецЕсли;
	//-бит_Сафаров ШИ 04.09.2026

	Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CONFIRMED"
		И Не бит_ЗаявкаПодтверждена(ЗаписьОчереди.Заявка) Тогда
		бит_ПовторитьПозже(ЗаписьОчереди, "Подтверждение заявки еще не зафиксировано.");
		Возврат;
	КонецЕсли;

	Шаблон = ЗаписьОчереди.Рассылка.Шаблон;
	//+бит.Сидорук С.В. 14.10.2026
	//БЫЛО
	//Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_REMINDER"
	//	И бит_ЗаявкаПодтверждена(ЗаписьОчереди.Заявка) Тогда
	//СТАЛО
	Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_REMINDER" Тогда
	//-бит.Сидорук С.В. 14.10.2026

		Шаблон = Справочники.бит_омни_ШаблоныСообщений.СтандартныйШаблон(
			"MAX_APPOINTMENT_REMINDER_CONFIRMED");
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Шаблон) Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Ошибка", "Не найден шаблон сообщения.");
		Возврат;
	КонецЕсли;

	Контекст = бит_КонтекстЗаявки(ЗаписьОчереди.Заявка, ДанныеЗаявки);
	//+бит_Сафаров ШИ 16.09.2026
	Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_DEBT" Тогда
		Контекст.Вставить("debt_amount", бит_ДолгКлиента(ДанныеЗаявки.Клиент));
	ИначеЕсли ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CANCELLED" Тогда
		Контекст.Вставить("appointment_date", ЗаписьОчереди.ДатаЗаписи);
		Контекст.Вставить("appointment_time", ЗаписьОчереди.ДатаЗаписи);
	КонецЕсли;
	//-бит_Сафаров ШИ 16.09.2026

	Попытка
		РезультатОтправки = бит_омни_ИнтеграцияСMAX.ОтправитьСообщение(
			Шаблон,
			ДанныеЗаявки.Клиент,
			ЗаписьОчереди.Бот,
			Контекст);

		Если Не бит_УспешныйРезультатОтправки(РезультатОтправки) Тогда
			бит_ПовторитьПозже(ЗаписьОчереди, бит_ОписаниеРезультатаОтправки(РезультатОтправки));
			Возврат;
		КонецЕсли;

		ДатаФактическойОтправки = ТекущаяДатаСеанса();
		ЗаписьОчереди.Статус = "Отправлено";
		ЗаписьОчереди.ДатаОтправки = ДатаФактическойОтправки;
		ЗаписьОчереди.ТекстОшибки = "";
		ЗаписьОчереди.Записать();
		//+бит_Сафаров ШИ 16.09.2026
		//+бит.Сидорук С.В. 14.10.2026
		//БЫЛО
		//Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CONFIRM_REQUEST"
		//	Или ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CONFIRMED" Тогда
		//СТАЛО
		Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CREATED"
			Или ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CONFIRMED" Тогда
		//-бит.Сидорук С.В. 14.10.2026

			Попытка
				Если бит_ДолгКлиента(ДанныеЗаявки.Клиент) > 0 Тогда
					КлючДолга = бит_КлючСобытия(
						"MAX_APPOINTMENT_DEBT", ЗаписьОчереди.Заявка, ДанныеЗаявки.ДатаНачала);
					Если Не бит_СтрокаОчередиСуществует(ЗаписьОчереди.Бот, КлючДолга) Тогда
						бит_ПоставитьСобытиеВОчередь(
							ЗаписьОчереди.Заявка, "MAX_APPOINTMENT_DEBT",
							ДатаФактическойОтправки, ДанныеЗаявки.ДатаНачала, ЗаписьОчереди.Бот);
						Если бит_СтрокаОчередиСуществует(ЗаписьОчереди.Бот, КлючДолга) Тогда
							бит_ОбработатьСтрокуОчереди(ЗаписьОчереди.Бот, КлючДолга);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			Исключение
				ЗаписьЖурналаРегистрации("ОМНИ.MAX.Задолженность",
					УровеньЖурналаРегистрации.Ошибка, , ЗаписьОчереди.Заявка,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
		//-бит_Сафаров ШИ 16.09.2026

		//+бит.Сидорук С.В. 14.10.2026
		//БЫЛО
		//Если (ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CONFIRM_REQUEST"
		//	Или ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_REMINDER")
		//	И Не бит_ЗаявкаПодтверждена(ЗаписьОчереди.Заявка) Тогда
		//СТАЛО
		Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CONFIRM_REQUEST"
			И Не бит_ЗаявкаПодтверждена(ЗаписьОчереди.Заявка) Тогда
		//-бит.Сидорук С.В. 14.10.2026

			Попытка
				бит_ПоставитьКонтрольОтсутствияОтветаВОчередь(

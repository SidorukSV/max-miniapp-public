Функция бит_КлючСобытия(ИдентификаторСценария, Заявка, ДатаЗаписи, ИнтервалНапоминанияЧасов = 0)

	Ключ = ИдентификаторСценария + ":" + Строка(Заявка.УникальныйИдентификатор());
	Если ЗначениеЗаполнено(ДатаЗаписи)
		//+бит.Сидорук С.В. 14.10.2026
		//БЫЛО
		//И (ИдентификаторСценария = "MAX_APPOINTMENT_REMINDER"
		//СТАЛО
		И (ИдентификаторСценария = "MAX_APPOINTMENT_REMINDER"
			Или ИдентификаторСценария = "MAX_APPOINTMENT_CREATED"
			Или ИдентификаторСценария = "MAX_APPOINTMENT_CONFIRM_REQUEST"
		//-бит.Сидорук С.В. 14.10.2026

			//+бит_Сафаров ШИ 16.09.2026
			Или ИдентификаторСценария = "MAX_APPOINTMENT_DEBT"
			Или ИдентификаторСценария = "MAX_APPOINTMENT_CANCELLED"
			//-бит_Сафаров ШИ 16.09.2026
			Или ИдентификаторСценария = "MAX_APPOINTMENT_NO_RESPONSE"
			Или ИдентификаторСценария = "MAX_CONFIRMATION_NO_RESPONSE") Тогда
		Ключ = Ключ + ":" + Формат(ДатаЗаписи, "ДФ=yyyyMMddHHmmss");
		//+бит_Сафаров ШИ 01.09.2026
		Если ИнтервалНапоминанияЧасов > 0 Тогда
			Ключ = Ключ + ":H" + Формат(ИнтервалНапоминанияЧасов, "ЧГ=0");
		КонецЕсли;
		//-бит_Сафаров ШИ 01.09.2026
	КонецЕсли;
	Возврат Ключ;


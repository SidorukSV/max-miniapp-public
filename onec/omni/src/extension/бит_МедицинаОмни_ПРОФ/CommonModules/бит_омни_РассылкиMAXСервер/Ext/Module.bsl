Функция бит_ДатаЗапросаПодтвержденияMAX(ДатаПриема, ТекущаяДата) Экспорт
	//+бит.Сидорук С.В. 14.10.2026
	// Запись на сегодня подтверждается при записи документа, без кнопок.
	Если ДатаПриема <= ТекущаяДата Или НачалоДня(ДатаПриема) = НачалоДня(ТекущаяДата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Макс(ТекущаяДата, ДатаПриема - 24 * 3600);
	//-бит.Сидорук С.В. 14.10.2026

КонецФункции

Функция бит_ЕстьАктивныеРассылкиЗаписейMAX() Экспорт
	//+бит.Сидорук С.В. 14.10.2026
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	| Активные.Бот КАК Бот
	|ИЗ
	| РегистрСведений.бит_омни_АктивныеРассылки КАК Активные
	|  ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_омни_СтандартныеРассылкиMAX КАК Стандартные
	|  ПО Активные.Бот = Стандартные.Бот И Активные.Рассылка = Стандартные.Рассылка
	|ГДЕ
	| Стандартные.ИдентификаторСценария В (&Сценарии)
	| И Активные.Бот.Использовать
	| И Активные.Бот.Канал = ЗНАЧЕНИЕ(Перечисление.бит_омни_КаналыСвязи.MAX)
	| И НЕ Активные.Рассылка.ПометкаУдаления";
	Сценарии = Новый Массив;
	Сценарии.Добавить("MAX_APPOINTMENT_CREATED");
	Сценарии.Добавить("MAX_APPOINTMENT_CONFIRM_REQUEST");
	Запрос.УстановитьПараметр("Сценарии", Сценарии);
	Возврат Не Запрос.Выполнить().Пустой();
	//-бит.Сидорук С.В. 14.10.2026


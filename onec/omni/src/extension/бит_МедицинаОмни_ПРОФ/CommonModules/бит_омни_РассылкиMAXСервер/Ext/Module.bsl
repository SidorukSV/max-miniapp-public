Процедура бит_ПоставитьКонтрольОтсутствияОтветаВОчередь(Бот, Рассылка, Заявка, Клиент, ДатаЗаписи, ДатаОтправки)

	//+бит_Сафаров ШИ 04.09.2026
	СрокОжиданияЧасов = бит_СрокОжиданияПодтвержденияMAXЧасов();
	Если СрокОжиданияЧасов <= 0
		Или Не ЗначениеЗаполнено(ДатаЗаписи)
		Или Не ЗначениеЗаполнено(ДатаОтправки)
		Или Не ЗначениеЗаполнено(Документы.Заявка.бит_СтатусНеподтвержденнойЗаявки()) Тогда
		Возврат;
	КонецЕсли;

	КлючСобытия = бит_КлючСобытия("MAX_CONFIRMATION_NO_RESPONSE", Заявка, ДатаЗаписи);
	Если бит_СтрокаОчередиСуществует(Бот, КлючСобытия) Тогда
		Возврат;
	КонецЕсли;

	ЗаписьОчереди = РегистрыСведений.бит_омни_ОчередьРассылокMAX.СоздатьМенеджерЗаписи();
	ЗаписьОчереди.Бот = Бот;
	ЗаписьОчереди.КлючСобытия = КлючСобытия;
	ЗаписьОчереди.ИдентификаторСценария = "MAX_CONFIRMATION_NO_RESPONSE";
	ЗаписьОчереди.Рассылка = Рассылка;
	ЗаписьОчереди.Заявка = Заявка;
	ЗаписьОчереди.Клиент = Клиент;
	ЗаписьОчереди.ДатаВыполнения = ДатаОтправки + СрокОжиданияЧасов * 3600;
	ЗаписьОчереди.ДатаЗаписи = ДатаЗаписи;
	ЗаписьОчереди.ДатаОтправки = ДатаОтправки;
	ЗаписьОчереди.ИнтервалНапоминанияЧасов = СрокОжиданияЧасов;
	ЗаписьОчереди.Статус = "Ожидает";
	ЗаписьОчереди.КоличествоПопыток = 0;
	ЗаписьОчереди.Записать();
	//-бит_Сафаров ШИ 04.09.2026

КонецПроцедуры

Процедура бит_ОбработатьОтсутствиеОтвета(ЗаписьОчереди)

	//+бит_Сафаров ШИ 04.09.2026
	Если бит_ЗаявкаПодтверждена(ЗаписьОчереди.Заявка) Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Заявка подтверждена пациентом.");
		Возврат;
	КонецЕсли;

	СтатусНеподтвержденнойЗаявки = Документы.Заявка.бит_СтатусНеподтвержденнойЗаявки();
	Если Не ЗначениеЗаполнено(СтатусНеподтвержденнойЗаявки) Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Статус неподтвержденной заявки (MAX) не настроен.");
		Возврат;
	КонецЕсли;

	ТекущееСостояние = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаписьОчереди.Заявка, "Состояние");
	Если ТекущееСостояние = СтатусНеподтвержденнойЗаявки Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Выполнено", "Статус неподтвержденной заявки уже установлен.");
		Возврат;
	КонецЕсли;

	Попытка
		ЗаявкаОбъект = ЗаписьОчереди.Заявка.ПолучитьОбъект();
		ЗаявкаОбъект.Состояние = СтатусНеподтвержденнойЗаявки;
		ЗаявкаОбъект.Записать();

		СостояниеПослеЗаписи = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ЗаписьОчереди.Заявка,
			"Состояние");
		Если СостояниеПослеЗаписи <> СтатусНеподтвержденнойЗаявки Тогда
			ВызватьИсключение СтрШаблон(
				"После записи состояние заявки не изменилось: %1",
				СостояниеПослеЗаписи);
		КонецЕсли;

		бит_УстановитьСтатус(ЗаписьОчереди, "Выполнено", "Статус неподтвержденной заявки установлен.");
	Исключение
		бит_УстановитьСтатус(
			ЗаписьОчереди,
			"Ошибка",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	//-бит_Сафаров ШИ 04.09.2026

КонецПроцедуры


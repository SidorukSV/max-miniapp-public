	|	И АктивныеРассылки.Рассылка = &Рассылка
	|	И НЕ АктивныеРассылки.Рассылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("Бот", Бот);
	Запрос.УстановитьПараметр("Рассылка", Рассылка);

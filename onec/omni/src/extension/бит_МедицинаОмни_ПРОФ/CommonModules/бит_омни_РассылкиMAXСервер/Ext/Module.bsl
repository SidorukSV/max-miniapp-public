Функция бит_УспешныйРезультатОтправки(РезультатОтправки)

	Если РезультатОтправки = Неопределено Или РезультатОтправки = Null Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(РезультатОтправки) = Тип("Структура") Тогда
		Успех = Истина;
		Если РезультатОтправки.Свойство("success", Успех) И Не Успех Тогда
			Возврат Ложь;
		КонецЕсли;
		Ошибка = Неопределено;
		Если РезультатОтправки.Свойство("error", Ошибка) И ЗначениеЗаполнено(Ошибка) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция бит_ОписаниеРезультатаОтправки(РезультатОтправки)

	Если РезультатОтправки = Неопределено Или РезультатОтправки = Null Тогда
		Возврат "MAX не вернул результат отправки.";
	КонецЕсли;

	Если ТипЗнч(РезультатОтправки) = Тип("Структура") Тогда
		Текст = "";
		Если РезультатОтправки.Свойство("message", Текст) И ЗначениеЗаполнено(Текст) Тогда
			Возврат Строка(Текст);
		КонецЕсли;
		Если РезультатОтправки.Свойство("error", Текст) И ЗначениеЗаполнено(Текст) Тогда
			Возврат Строка(Текст);
		КонецЕсли;
	КонецЕсли;

	Возврат "MAX отклонил сообщение.";


	КонецПопытки;

КонецПроцедуры

Функция бит_ДанныеЗаявки(Заявка)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заявка.Клиент КАК Клиент,
	|	Заявка.ДатаНачала КАК ДатаНачала,
	|	Заявка.Сотрудник КАК Сотрудник,
	|	Заявка.Филиал КАК Филиал,
	|	Заявка.ПометкаУдаления КАК ПометкаУдаления,
	|	ВЫБОР
	|		КОГДА Заявка.Состояние.ТипСостояния = ЗНАЧЕНИЕ(Перечисление.ТипыСостоянийЗаявок.Отменена)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Отменена
	|ИЗ
	|	Документ.Заявка КАК Заявка
	|ГДЕ
	|	Заявка.Ссылка = &Заявка";
	Запрос.УстановитьПараметр("Заявка", Заявка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Выборка.ПометкаУдаления Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура(
		"Клиент, ДатаНачала, Сотрудник, Филиал, Отменена",
		Выборка.Клиент,
		Выборка.ДатаНачала,
		Выборка.Сотрудник,
		Выборка.Филиал,
		Выборка.Отменена);

КонецФункции

Функция бит_КонтекстЗаявки(Заявка, ДанныеЗаявки)

	Возврат Новый Структура(
		"appointment_id, appointment_date, appointment_time, doctor, address",
		Строка(Заявка.УникальныйИдентификатор()),
		ДанныеЗаявки.ДатаНачала,
		ДанныеЗаявки.ДатаНачала,
		ДанныеЗаявки.Сотрудник,
		ДанныеЗаявки.Филиал);


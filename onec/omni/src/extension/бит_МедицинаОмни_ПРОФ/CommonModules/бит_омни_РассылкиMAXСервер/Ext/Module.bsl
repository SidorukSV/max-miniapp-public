Функция бит_СтрокаОчередиСуществует(Бот, КлючСобытия)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Очередь.КлючСобытия КАК КлючСобытия
	|ИЗ
	|	РегистрСведений.бит_омни_ОчередьРассылокMAX КАК Очередь
	|ГДЕ
	|	Очередь.Бот = &Бот
	|	И Очередь.КлючСобытия = &КлючСобытия";
	Запрос.УстановитьПараметр("Бот", Бот);
	Запрос.УстановитьПараметр("КлючСобытия", КлючСобытия);
	Возврат Не Запрос.Выполнить().Пустой();


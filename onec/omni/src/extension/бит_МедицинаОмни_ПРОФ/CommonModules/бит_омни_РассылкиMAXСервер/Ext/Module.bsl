Процедура бит_СформироватьЗапросыПодтвержденияMAX()
	//+бит.Сидорук С.В. 14.10.2026
	// Подхватывает существующие будущие записи и пропущенные запуски задания.
	ТекущаяДата = ТекущаяДатаСеанса();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Заявка.Ссылка КАК Заявка
	|ИЗ Документ.Заявка КАК Заявка
	|ГДЕ НЕ Заявка.ПометкаУдаления
	| И Заявка.ДатаНачала >= &Завтра
	| И Заявка.ДатаНачала <= &Граница
	| И Заявка.Состояние.ТипСостояния <> ЗНАЧЕНИЕ(Перечисление.ТипыСостоянийЗаявок.Отменена)";
	Запрос.УстановитьПараметр("Завтра", НачалоДня(ТекущаяДата) + 24 * 3600);
	Запрос.УстановитьПараметр("Граница", ТекущаяДата + 24 * 3600);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		бит_ПоставитьЗапросПодтвержденияВОчередь(Выборка.Заявка);
	КонецЦикла;
	//-бит.Сидорук С.В. 14.10.2026


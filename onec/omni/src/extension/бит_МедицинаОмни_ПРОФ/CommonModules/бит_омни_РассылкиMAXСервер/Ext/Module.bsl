#Область ПрограммныйИнтерфейс

Процедура бит_ПоставитьЗапросПодтвержденияВОчередь(Заявка) Экспорт

	Если Не ЗначениеЗаполнено(Заявка) Или бит_ЗаявкаПодтверждена(Заявка) Тогда
		Возврат;
	КонецЕсли;

	бит_ПоставитьСобытиеВОчередь(
		Заявка,
		"MAX_APPOINTMENT_CONFIRM_REQUEST",
		ТекущаяДатаСеанса());

КонецПроцедуры

Процедура бит_ПоставитьПодтверждениеВОчередь(Заявка) Экспорт

	Если Не ЗначениеЗаполнено(Заявка) Тогда
		Возврат;
	КонецЕсли;

	бит_ПоставитьСобытиеВОчередь(
		Заявка,
		"MAX_APPOINTMENT_CONFIRMED",
		ТекущаяДатаСеанса());

КонецПроцедуры

Функция бит_ЗаявкаПодтверждена(Заявка) Экспорт

	Если Не ЗначениеЗаполнено(Заявка) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПризнакПодтвержденнойЗаявки =
		УправлениеНастройками.ПолучитьПараметрУчетнойПолитики("ПризнакПодтвержденнойЗаявки");
	Если Не ЗначениеЗаполнено(ПризнакПодтвержденнойЗаявки) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(ПризнакПодтвержденнойЗаявки) = Тип("СправочникСсылка.ВидыСостоянийЗаявок") Тогда
		Состояние = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Заявка, "Состояние");
		Возврат Состояние = ПризнакПодтвержденнойЗаявки;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗначенияСвойств.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойств
	|ГДЕ
	|	ЗначенияСвойств.Объект = &Объект
	|	И ЗначенияСвойств.Свойство = &Свойство";
	Запрос.УстановитьПараметр("Объект", Заявка);
	Запрос.УстановитьПараметр("Свойство", ПризнакПодтвержденнойЗаявки);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий() И Выборка.Значение = Истина;

КонецФункции

Функция бит_ЭтоУправляемаяСтандартнаяРассылка(Рассылка) Экспорт

	Если Не ЗначениеЗаполнено(Рассылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	СтандартныеРассылки.Рассылка КАК Рассылка
	|ИЗ
	|	РегистрСведений.бит_омни_СтандартныеРассылкиMAX КАК СтандартныеРассылки
	|ГДЕ
	|	СтандартныеРассылки.Рассылка = &Рассылка";
	Запрос.УстановитьПараметр("Рассылка", Рассылка);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Процедура бит_ОбеспечитьРегламентноеЗадание() Экспорт

	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ДатаНачала = ТекущаяДатаСеанса();
	Расписание.ПериодПовтораДней = 1;
	Расписание.ПериодПовтораВТечениеДня = 300;
	Для НомерДня = 1 По 7 Цикл
		Расписание.ДниНедели.Добавить(НомерДня);
	КонецЦикла;

	КлючЗадания = "бит_омни_РассылкиMAX";
	ОбработчикЗадания = "бит_омни_РаботаССообщениями.Рассылки();";
	Задание = РаботаСРасширениями.НайтиРегламентноеЗаданиеРасширенияПоКлючу(КлючЗадания);
	Если Задание = Неопределено Тогда
		РаботаСРасширениями.ДобавитьРегламентноеЗаданиеРасширения(
			КлючЗадания,
			ОбработчикЗадания,
			"ОМНИ: очередь и напоминания MAX",
			Расписание);
		Возврат;
	КонецЕсли;

	Задание.Наименование = "ОМНИ: очередь и напоминания MAX";
	Задание.Использование = Истина;
	ЗаполнитьЗначенияСвойств(Задание.Расписание, Расписание);
	Задание.Параметры.Очистить();
	Задание.Параметры.Добавить(ОбработчикЗадания);
	Задание.Записать();

КонецПроцедуры

Процедура бит_ОбработатьОчередь() Экспорт

	бит_СформироватьОчередьНапоминаний();

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 100
	|	Очередь.Бот КАК Бот,
	|	Очередь.КлючСобытия КАК КлючСобытия
	|ИЗ
	|	РегистрСведений.бит_омни_ОчередьРассылокMAX КАК Очередь
	|ГДЕ
	|	Очередь.Статус В(&Статусы)
	|	И Очередь.ДатаВыполнения <= &ТекущаяДата
	|	И (Очередь.СледующаяПопытка = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ Очередь.СледующаяПопытка <= &ТекущаяДата)
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.ДатаВыполнения";

	Статусы = Новый Массив;
	Статусы.Добавить("Ожидает");
	Статусы.Добавить("Повтор");
	Запрос.УстановитьПараметр("Статусы", Статусы);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		бит_ОбработатьСтрокуОчереди(Выборка.Бот, Выборка.КлючСобытия);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура бит_ПоставитьСобытиеВОчередь(Заявка, ИдентификаторСценария, ДатаВыполнения, ДатаЗаписи = Неопределено)

	ДанныеЗаявки = бит_ДанныеЗаявки(Заявка);
	Если ДанныеЗаявки = Неопределено Или Не ЗначениеЗаполнено(ДанныеЗаявки.Клиент) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СтандартныеРассылки.Бот КАК Бот,
	|	СтандартныеРассылки.Рассылка КАК Рассылка
	|ИЗ
	|	РегистрСведений.бит_омни_СтандартныеРассылкиMAX КАК СтандартныеРассылки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_омни_АктивныеРассылки КАК АктивныеРассылки
	|		ПО СтандартныеРассылки.Бот = АктивныеРассылки.Бот
	|			И СтандартныеРассылки.Рассылка = АктивныеРассылки.Рассылка
	|ГДЕ
	|	СтандартныеРассылки.ИдентификаторСценария = &ИдентификаторСценария
	|	И НЕ СтандартныеРассылки.Рассылка.ПометкаУдаления
	|	И СтандартныеРассылки.Бот.Использовать";
	Запрос.УстановитьПараметр("ИдентификаторСценария", ИдентификаторСценария);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		КлючСобытия = бит_КлючСобытия(ИдентификаторСценария, Заявка, ДатаЗаписи);
		Если бит_СтрокаОчередиСуществует(Выборка.Бот, КлючСобытия) Тогда
			Продолжить;
		КонецЕсли;

		ЗаписьОчереди = РегистрыСведений.бит_омни_ОчередьРассылокMAX.СоздатьМенеджерЗаписи();
		ЗаписьОчереди.Бот = Выборка.Бот;
		ЗаписьОчереди.КлючСобытия = КлючСобытия;
		ЗаписьОчереди.ИдентификаторСценария = ИдентификаторСценария;
		ЗаписьОчереди.Рассылка = Выборка.Рассылка;
		ЗаписьОчереди.Заявка = Заявка;
		ЗаписьОчереди.Клиент = ДанныеЗаявки.Клиент;
		ЗаписьОчереди.ДатаВыполнения = ДатаВыполнения;
		ЗаписьОчереди.ДатаЗаписи = ?(ДатаЗаписи = Неопределено, ДанныеЗаявки.ДатаНачала, ДатаЗаписи);
		ЗаписьОчереди.Статус = "Ожидает";
		ЗаписьОчереди.КоличествоПопыток = 0;
		ЗаписьОчереди.Записать();

	КонецЦикла;

КонецПроцедуры

Процедура бит_СформироватьОчередьНапоминаний()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СтандартныеРассылки.Бот КАК Бот,
	|	СтандартныеРассылки.Рассылка КАК Рассылка,
	|	СтандартныеРассылки.Рассылка.Расписание КАК Расписание,
	|	АктивныеРассылки.ДатаНачалаПоследнегоЗапуска КАК ДатаНачалаПоследнегоЗапуска,
	|	АктивныеРассылки.ДатаЗавершенияПоследнегоЗапуска КАК ДатаЗавершенияПоследнегоЗапуска
	|ИЗ
	|	РегистрСведений.бит_омни_СтандартныеРассылкиMAX КАК СтандартныеРассылки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_омни_АктивныеРассылки КАК АктивныеРассылки
	|		ПО СтандартныеРассылки.Бот = АктивныеРассылки.Бот
	|			И СтандартныеРассылки.Рассылка = АктивныеРассылки.Рассылка
	|ГДЕ
	|	СтандартныеРассылки.ИдентификаторСценария = &ИдентификаторСценария
	|	И НЕ СтандартныеРассылки.Рассылка.ПометкаУдаления
	|	И СтандартныеРассылки.Бот.Использовать";
	Запрос.УстановитьПараметр("ИдентификаторСценария", "MAX_APPOINTMENT_REMINDER");

	ТекущаяДата = ТекущаяДатаСеанса();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Расписание = Выборка.Расписание.Получить();
		Если ТипЗнч(Расписание) <> Тип("РасписаниеРегламентногоЗадания") Тогда
			Продолжить;
		КонецЕсли;

		Если Не Расписание.ТребуетсяВыполнение(
			ТекущаяДата,
			Выборка.ДатаНачалаПоследнегоЗапуска,
			Выборка.ДатаЗавершенияПоследнегоЗапуска) Тогда
			Продолжить;
		КонецЕсли;

		бит_ОтметитьНачалоРассылки(Выборка.Бот, Выборка.Рассылка, ТекущаяДата);

		ДатаНачалаОкна = ?(
			ЗначениеЗаполнено(Выборка.ДатаЗавершенияПоследнегоЗапуска),
			Выборка.ДатаЗавершенияПоследнегоЗапуска + 7200,
			ТекущаяДата + 7200);
		Если ДатаНачалаОкна < ТекущаяДата Тогда
			ДатаНачалаОкна = ТекущаяДата;
		КонецЕсли;
		ДатаОкончанияОкна = ТекущаяДата + 7200 + 300;

		бит_ПоставитьНапоминанияВОчередь(
			Выборка.Бот,
			Выборка.Рассылка,
			ДатаНачалаОкна,
			ДатаОкончанияОкна,
			ТекущаяДата);

		бит_ОтметитьЗавершениеРассылки(Выборка.Бот, Выборка.Рассылка, ТекущаяДатаСеанса());

	КонецЦикла;

КонецПроцедуры

Процедура бит_ПоставитьНапоминанияВОчередь(Бот, Рассылка, ДатаНачалаОкна, ДатаОкончанияОкна, ДатаВыполнения)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Заявка.Ссылка КАК Заявка,
	|	Заявка.Клиент КАК Клиент,
	|	Заявка.ДатаНачала КАК ДатаНачала
	|ИЗ
	|	Документ.Заявка КАК Заявка
	|ГДЕ
	|	НЕ Заявка.ПометкаУдаления
	|	И Заявка.ДатаНачала >= &ДатаНачалаОкна
	|	И Заявка.ДатаНачала <= &ДатаОкончанияОкна
	|	И Заявка.ДатаНачала > &ТекущаяДата
	|	И Заявка.Состояние.ТипСостояния <> ЗНАЧЕНИЕ(Перечисление.ТипыСостоянийЗаявок.Отменена)";
	Запрос.УстановитьПараметр("ДатаНачалаОкна", ДатаНачалаОкна);
	Запрос.УстановитьПараметр("ДатаОкончанияОкна", ДатаОкончанияОкна);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		КлючСобытия = бит_КлючСобытия("MAX_APPOINTMENT_REMINDER", Выборка.Заявка, Выборка.ДатаНачала);
		Если бит_СтрокаОчередиСуществует(Бот, КлючСобытия) Тогда
			Продолжить;
		КонецЕсли;

		ЗаписьОчереди = РегистрыСведений.бит_омни_ОчередьРассылокMAX.СоздатьМенеджерЗаписи();
		ЗаписьОчереди.Бот = Бот;
		ЗаписьОчереди.КлючСобытия = КлючСобытия;
		ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_REMINDER";
		ЗаписьОчереди.Рассылка = Рассылка;
		ЗаписьОчереди.Заявка = Выборка.Заявка;
		ЗаписьОчереди.Клиент = Выборка.Клиент;
		ЗаписьОчереди.ДатаВыполнения = ДатаВыполнения;
		ЗаписьОчереди.ДатаЗаписи = Выборка.ДатаНачала;
		ЗаписьОчереди.Статус = "Ожидает";
		ЗаписьОчереди.Записать();

	КонецЦикла;

КонецПроцедуры

Процедура бит_ОбработатьСтрокуОчереди(Бот, КлючСобытия)

	ЗаписьОчереди = РегистрыСведений.бит_омни_ОчередьРассылокMAX.СоздатьМенеджерЗаписи();
	ЗаписьОчереди.Бот = Бот;
	ЗаписьОчереди.КлючСобытия = КлючСобытия;
	ЗаписьОчереди.Прочитать();

	Если Не бит_РассылкаАктивна(ЗаписьОчереди.Бот, ЗаписьОчереди.Рассылка) Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Рассылка отключена для бота.");
		Возврат;
	КонецЕсли;

	ДанныеЗаявки = бит_ДанныеЗаявки(ЗаписьОчереди.Заявка);
	Если ДанныеЗаявки = Неопределено Или ДанныеЗаявки.Отменена Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Заявка отсутствует, удалена или отменена.");
		Возврат;
	КонецЕсли;

	Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CONFIRM_REQUEST"
		И бит_ЗаявкаПодтверждена(ЗаписьОчереди.Заявка) Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Пропущено", "Заявка уже подтверждена.");
		Возврат;
	КонецЕсли;

	Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_CONFIRMED"
		И Не бит_ЗаявкаПодтверждена(ЗаписьОчереди.Заявка) Тогда
		бит_ПовторитьПозже(ЗаписьОчереди, "Подтверждение заявки еще не зафиксировано.");
		Возврат;
	КонецЕсли;

	Шаблон = ЗаписьОчереди.Рассылка.Шаблон;
	Если ЗаписьОчереди.ИдентификаторСценария = "MAX_APPOINTMENT_REMINDER"
		И бит_ЗаявкаПодтверждена(ЗаписьОчереди.Заявка) Тогда
		Шаблон = Справочники.бит_омни_ШаблоныСообщений.СтандартныйШаблон(
			"MAX_APPOINTMENT_REMINDER_CONFIRMED");
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Шаблон) Тогда
		бит_УстановитьСтатус(ЗаписьОчереди, "Ошибка", "Не найден шаблон сообщения.");
		Возврат;
	КонецЕсли;

	Контекст = бит_КонтекстЗаявки(ЗаписьОчереди.Заявка, ДанныеЗаявки);

	Попытка
		РезультатОтправки = бит_омни_ИнтеграцияСMAX.ОтправитьСообщение(
			Шаблон,
			ДанныеЗаявки.Клиент,
			ЗаписьОчереди.Бот,
			Контекст);

		Если Не бит_УспешныйРезультатОтправки(РезультатОтправки) Тогда
			бит_ПовторитьПозже(ЗаписьОчереди, бит_ОписаниеРезультатаОтправки(РезультатОтправки));
			Возврат;
		КонецЕсли;

		ЗаписьОчереди.Статус = "Отправлено";
		ЗаписьОчереди.ДатаОтправки = ТекущаяДатаСеанса();
		ЗаписьОчереди.ТекстОшибки = "";
		ЗаписьОчереди.Записать();
	Исключение
		бит_ПовторитьПозже(
			ЗаписьОчереди,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция бит_ДанныеЗаявки(Заявка)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заявка.Клиент КАК Клиент,
	|	Заявка.ДатаНачала КАК ДатаНачала,
	|	Заявка.Сотрудник КАК Сотрудник,
	|	Заявка.Филиал КАК Филиал,
	|	Заявка.ПометкаУдаления КАК ПометкаУдаления,
	|	ВЫБОР
	|		КОГДА Заявка.Состояние.ТипСостояния = ЗНАЧЕНИЕ(Перечисление.ТипыСостоянийЗаявок.Отменена)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Отменена
	|ИЗ
	|	Документ.Заявка КАК Заявка
	|ГДЕ
	|	Заявка.Ссылка = &Заявка";
	Запрос.УстановитьПараметр("Заявка", Заявка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или Выборка.ПометкаУдаления Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура(
		"Клиент, ДатаНачала, Сотрудник, Филиал, Отменена",
		Выборка.Клиент,
		Выборка.ДатаНачала,
		Выборка.Сотрудник,
		Выборка.Филиал,
		Выборка.Отменена);

КонецФункции


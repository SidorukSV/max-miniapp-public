Функция бит_ИнтервалыНапоминаний(Бот)

	//+бит_Сафаров ШИ 01.09.2026
	Интервалы = Новый Массив;
	Если Не ЗначениеЗаполнено(Бот) Тогда
		Возврат Интервалы;
	КонецЕсли;

	ОбъектБота = Бот.ПолучитьОбъект();
	УникальныеИнтервалы = Новый Соответствие;
	Для Каждого СтрокаИнтервала Из ОбъектБота.ИнтервалыНапоминанийMAX Цикл
		ЧасовДоПриема = СтрокаИнтервала.ЧасовДоПриема;
		Если ЧасовДоПриема <= 0
			Или УникальныеИнтервалы.Получить(ЧасовДоПриема) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УникальныеИнтервалы.Вставить(ЧасовДоПриема, Истина);
		Интервалы.Добавить(ЧасовДоПриема);
	КонецЦикла;

	Если Интервалы.Количество() = 0 И ОбъектБота.НапоминатьЗаЧасовMAX > 0 Тогда
		Интервалы.Добавить(ОбъектБота.НапоминатьЗаЧасовMAX);
	КонецЕсли;
	Возврат Интервалы;

Процедура бит_ПоставитьЗапросПодтвержденияВОчередь(Заявка) Экспорт

	Если Не ЗначениеЗаполнено(Заявка) Или бит_ЗаявкаПодтверждена(Заявка) Тогда
		Возврат;
	КонецЕсли;

	//+бит.Сидорук С.В. 14.10.2026
	//БЫЛО
	//бит_ПоставитьСобытиеВОчередь(
	//	Заявка,
	//	"MAX_APPOINTMENT_CONFIRM_REQUEST",
	//	ТекущаяДатаСеанса());
	//СТАЛО
	ДанныеЗаявки = бит_ДанныеЗаявки(Заявка);
	Если ДанныеЗаявки = Неопределено Или ДанныеЗаявки.Отменена Тогда
		Возврат;
	КонецЕсли;
	ДатаОтправки = бит_ДатаЗапросаПодтвержденияMAX(ДанныеЗаявки.ДатаНачала, ТекущаяДатаСеанса());
	Если ДатаОтправки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	бит_ПоставитьСобытиеВОчередь(Заявка, "MAX_APPOINTMENT_CONFIRM_REQUEST",
		ДатаОтправки, ДанныеЗаявки.ДатаНачала);
	//-бит.Сидорук С.В. 14.10.2026


КонецПроцедуры

Процедура бит_ПоставитьУведомлениеОЗаписиВОчередь(Заявка) Экспорт
	//+бит.Сидорук С.В. 14.10.2026
	ДанныеЗаявки = бит_ДанныеЗаявки(Заявка);
	Если ДанныеЗаявки = Неопределено Или ДанныеЗаявки.Отменена
		Или ДанныеЗаявки.ДатаНачала <= ТекущаяДатаСеанса() Тогда
		Возврат;
	КонецЕсли;
	бит_ПоставитьСобытиеВОчередь(Заявка, "MAX_APPOINTMENT_CREATED",
		ТекущаяДатаСеанса(), ДанныеЗаявки.ДатаНачала);
	//-бит.Сидорук С.В. 14.10.2026


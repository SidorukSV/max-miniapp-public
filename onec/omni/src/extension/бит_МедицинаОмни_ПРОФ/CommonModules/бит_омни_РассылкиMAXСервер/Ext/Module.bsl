Функция бит_ЗаявкаПодтверждена(Заявка) Экспорт

	Если Не ЗначениеЗаполнено(Заявка) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПризнакПодтвержденнойЗаявки =
		УправлениеНастройками.ПолучитьПараметрУчетнойПолитики("ПризнакПодтвержденнойЗаявки");
	Если Не ЗначениеЗаполнено(ПризнакПодтвержденнойЗаявки) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(ПризнакПодтвержденнойЗаявки) = Тип("СправочникСсылка.ВидыСостоянийЗаявок") Тогда
		Состояние = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Заявка, "Состояние");
		Возврат Состояние = ПризнакПодтвержденнойЗаявки;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗначенияСвойств.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойств
	|ГДЕ
	|	ЗначенияСвойств.Объект = &Объект
	|	И ЗначенияСвойств.Свойство = &Свойство";
	Запрос.УстановитьПараметр("Объект", Заявка);
	Запрос.УстановитьПараметр("Свойство", ПризнакПодтвержденнойЗаявки);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий() И Выборка.Значение = Истина;

КонецФункции

Функция бит_ЭтоУправляемаяСтандартнаяРассылка(Рассылка) Экспорт

	Если Не ЗначениеЗаполнено(Рассылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	СтандартныеРассылки.Рассылка КАК Рассылка
	|ИЗ
	|	РегистрСведений.бит_омни_СтандартныеРассылкиMAX КАК СтандартныеРассылки
	|ГДЕ
	|	СтандартныеРассылки.Рассылка = &Рассылка";
	Запрос.УстановитьПараметр("Рассылка", Рассылка);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Процедура бит_ОбеспечитьРегламентноеЗадание() Экспорт

	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ДатаНачала = ТекущаяДатаСеанса();
	Расписание.ПериодПовтораДней = 1;
	Расписание.ПериодПовтораВТечениеДня = 300;
	Для НомерДня = 1 По 7 Цикл
		Расписание.ДниНедели.Добавить(НомерДня);
	КонецЦикла;

	КлючЗадания = "бит_омни_РассылкиMAX";
	ОбработчикЗадания = "бит_омни_РаботаССообщениями.Рассылки();";
	Задание = РаботаСРасширениями.НайтиРегламентноеЗаданиеРасширенияПоКлючу(КлючЗадания);
	Если Задание = Неопределено Тогда
		РаботаСРасширениями.ДобавитьРегламентноеЗаданиеРасширения(
			КлючЗадания,
			ОбработчикЗадания,
			"ОМНИ: очередь и напоминания MAX",
			Расписание);
		Возврат;
	КонецЕсли;

	Задание.Наименование = "ОМНИ: очередь и напоминания MAX";
	Задание.Использование = Истина;
	ЗаполнитьЗначенияСвойств(Задание.Расписание, Расписание);
	Задание.Параметры.Очистить();
	Задание.Параметры.Добавить(ОбработчикЗадания);
	Задание.Записать();


Процедура бит_ОбработатьОчередь() Экспорт

	//+бит.Сидорук С.В. 14.10.2026
	//БЫЛО
	//бит_СформироватьОчередьНапоминаний();
	//СТАЛО
	бит_СформироватьЗапросыПодтвержденияMAX();
	бит_СформироватьОчередьНапоминаний();
	//-бит.Сидорук С.В. 14.10.2026


	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 100
	|	Очередь.Бот КАК Бот,
	|	Очередь.КлючСобытия КАК КлючСобытия
	|ИЗ
	|	РегистрСведений.бит_омни_ОчередьРассылокMAX КАК Очередь
	|ГДЕ
	|	Очередь.Статус В(&Статусы)
	|	И Очередь.ДатаВыполнения <= &ТекущаяДата
	|	И (Очередь.СледующаяПопытка = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ Очередь.СледующаяПопытка <= &ТекущаяДата)
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.ДатаВыполнения";


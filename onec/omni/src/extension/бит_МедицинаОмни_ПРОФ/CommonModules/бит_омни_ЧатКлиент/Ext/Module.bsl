// Callback хранится в общем модуле: уведомление работает и после закрытия чата.
Процедура ОткрытьДиалогИзОповещения(КлючДиалога) Экспорт
	ФормаЧата = ОткрытьФорму("Обработка.бит_омни_ЕдиныйЧат.Форма.Форма");
	Если ФормаЧата <> Неопределено Тогда
		ФормаЧата.ОткрытьДиалогИзОповещения(КлючДиалога);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

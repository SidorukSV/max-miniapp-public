#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗагрузитьПациентовНаСервере();
	Сообщения.Очистить();
	ЛентаСообщений = Новый ФорматированныйДокумент;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьДоступностьОтправки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СтрокаПоискаПриИзменении(Элемент)

	ЗагрузитьПациентовНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ТолькоНепрочитанныеПриИзменении(Элемент)

	ЗагрузитьПациентовНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПациентыПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущийКонтакт = ТекущиеДанные.Контакт;
	ТекущийПациент = ТекущиеДанные.Пациент;
	ТекущийБот = ТекущиеДанные.Бот;
	Элементы.ЗаголовокЧата.Заголовок = СтрШаблон(
		"%1 · MAX: %2", ТекущиеДанные.Пациент, ТекущиеДанные.ИмяMAX);

	ЗагрузитьСообщенияНаСервере();
	ТекущиеДанные.Непрочитано = 0;
	ОбновитьДоступностьОтправки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	ЗагрузитьПациентовНаСервере();
	Если ЗначениеЗаполнено(ТекущийКонтакт) Тогда
		ЗагрузитьСообщенияНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьОбработка(Команда)

	Если Не ЗначениеЗаполнено(ТекущийКонтакт) Тогда
		Сообщить("Выберите пациента.");
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ТекстОтвета)) Тогда
		Сообщить("Введите текст сообщения.");
		Возврат;
	КонецЕсли;

	Результат = ОтправитьОтветНаСервере();
	Если Не Результат.Успех Тогда
		Сообщить(Результат.ОписаниеОшибки);
		Возврат;
	КонецЕсли;

	ТекстОтвета = "";
	ЗагрузитьСообщенияНаСервере();
	ЗагрузитьПациентовНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьПациентовНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	Контакты.Ссылка КАК Контакт,
				   |	ВЫРАЗИТЬ(Контакты.Получатель КАК Справочник.Клиенты) КАК Пациент,
				   |	Контакты.Наименование КАК ИмяMAX,
				   |	Контакты.Бот КАК Бот
				   |ПОМЕСТИТЬ ВТКонтакты
				   |ИЗ
				   |	Справочник.бит_омни_Контакты КАК Контакты
				   |ГДЕ
				   |	Контакты.Канал = ЗНАЧЕНИЕ(Перечисление.бит_омни_КаналыСвязи.MAX)
				   |	И Контакты.Получатель ССЫЛКА Справочник.Клиенты
				   |	И НЕ Контакты.ПометкаУдаления
				   |	И (&СтрокаПоиска = """"
				   |		ИЛИ Контакты.Наименование ПОДОБНО &ШаблонПоиска
				   |		ИЛИ ВЫРАЗИТЬ(Контакты.Получатель КАК Справочник.Клиенты).Наименование ПОДОБНО &ШаблонПоиска)
				   |
				   |ИНДЕКСИРОВАТЬ ПО
				   |	Контакт,
				   |	Бот
				   |;
				   |
				   |////////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	История.Контакт КАК Контакт,
				   |	История.Бот КАК Бот,
				   |	МАКСИМУМ(История.Период) КАК ДатаПоследнегоСообщения,
				   |	СУММА(ВЫБОР
				   |			КОГДА История.Входящее
				   |					И НЕ История.Прочитано
				   |				ТОГДА 1
				   |			ИНАЧЕ 0
				   |		КОНЕЦ) КАК Непрочитано
				   |ПОМЕСТИТЬ ВТПоследние
				   |ИЗ
				   |	РегистрСведений.бит_омни_ИсторияЧатовMAX КАК История
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКонтакты КАК Контакты
				   |		ПО История.Контакт = Контакты.Контакт
				   |			И История.Бот = Контакты.Бот
				   |СГРУППИРОВАТЬ ПО
				   |	История.Контакт,
				   |	История.Бот
				   |
				   |ИНДЕКСИРОВАТЬ ПО
				   |	Контакт,
				   |	Бот
				   |;
				   |
				   |////////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	Контакты.Контакт КАК Контакт,
				   |	Контакты.Пациент КАК Пациент,
				   |	Контакты.ИмяMAX КАК ИмяMAX,
				   |	Контакты.Бот КАК Бот,
				   |	ЕСТЬNULL(История.Текст, """") КАК ПоследнееСообщение,
				   |	Последние.ДатаПоследнегоСообщения КАК ДатаПоследнегоСообщения,
				   |	ЕСТЬNULL(Последние.Непрочитано, 0) КАК Непрочитано,
				   |	"""" КАК ПредставлениеДиалога,
				   |	ЕСТЬNULL(История.Входящее, ЛОЖЬ) КАК Входящее
				   |ИЗ
				   |	ВТКонтакты КАК Контакты
				   |		ЛЕВОЕ СОЕДИНЕНИЕ ВТПоследние КАК Последние
				   |		ПО Контакты.Контакт = Последние.Контакт
				   |			И Контакты.Бот = Последние.Бот
				   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_омни_ИсторияЧатовMAX КАК История
				   |		ПО Последние.Контакт = История.Контакт
				   |			И Последние.Бот = История.Бот
				   |			И Последние.ДатаПоследнегоСообщения = История.Период
				   |ГДЕ
				   |	НЕ &ТолькоНепрочитанные
				   |		ИЛИ ЕСТЬNULL(Последние.Непрочитано, 0) > 0
				   |
				   |УПОРЯДОЧИТЬ ПО
				   |	ДатаПоследнегоСообщения УБЫВ,
				   |	Пациент";

	СтрокаОтбора = СокрЛП(СтрокаПоиска);
	Запрос.УстановитьПараметр("СтрокаПоиска", СтрокаОтбора);
	Запрос.УстановитьПараметр("ШаблонПоиска", "%" + СтрокаОтбора + "%");
	Запрос.УстановитьПараметр("ТолькоНепрочитанные", ТолькоНепрочитанные);

	РезультатыПакета = Запрос.ВыполнитьПакет();
	ТаблицаПациентов = РезультатыПакета[РезультатыПакета.Количество() - 1].Выгрузить();
	СвернутыеДиалоги = ТаблицаПациентов.СкопироватьКолонки();
	УчтенныеКонтакты = Новый Соответствие;

	Для Каждого СтрокаПациента Из ТаблицаПациентов Цикл
		ОтборДиалога = Новый Структура("Пациент, Бот", СтрокаПациента.Пациент, СтрокаПациента.Бот);
		НайденныеДиалоги = СвернутыеДиалоги.НайтиСтроки(ОтборДиалога);
		Если НайденныеДиалоги.Количество() = 0 Тогда
			СтрокаДиалога = СвернутыеДиалоги.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДиалога, СтрокаПациента);
			СтрокаДиалога.Непрочитано = 0;
		Иначе
			СтрокаДиалога = НайденныеДиалоги[0];
		КонецЕсли;

		КлючКонтакта = Строка(СтрокаПациента.Контакт.УникальныйИдентификатор());
		Если УчтенныеКонтакты.Получить(КлючКонтакта) = Неопределено Тогда
			СтрокаДиалога.Непрочитано = СтрокаДиалога.Непрочитано + СтрокаПациента.Непрочитано;
			УчтенныеКонтакты.Вставить(КлючКонтакта, Истина);
		КонецЕсли;

		ЭтоБолееНовоеСообщение = СтрокаПациента.ДатаПоследнегоСообщения > СтрокаДиалога.ДатаПоследнегоСообщения;
		ЭтоОтветВТуЖеСекунду = СтрокаПациента.ДатаПоследнегоСообщения = СтрокаДиалога.ДатаПоследнегоСообщения
			И СтрокаДиалога.Входящее И Не СтрокаПациента.Входящее;
		Если ЭтоБолееНовоеСообщение Или ЭтоОтветВТуЖеСекунду Тогда
			СтрокаДиалога.Контакт = СтрокаПациента.Контакт;
			СтрокаДиалога.ИмяMAX = СтрокаПациента.ИмяMAX;
			СтрокаДиалога.ПоследнееСообщение = СтрокаПациента.ПоследнееСообщение;
			СтрокаДиалога.ДатаПоследнегоСообщения = СтрокаПациента.ДатаПоследнегоСообщения;
			СтрокаДиалога.Входящее = СтрокаПациента.Входящее;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаДиалога Из СвернутыеДиалоги Цикл
		ИндикаторНепрочитанного = ?(СтрокаДиалога.Непрочитано > 0, "  ●", "");
		ТекстПоследнегоСообщения = СокрЛП(СтрокаДиалога.ПоследнееСообщение);
		ТекстПоследнегоСообщения = СтрЗаменить(ТекстПоследнегоСообщения, Символы.ВК, " ");
		ТекстПоследнегоСообщения = СтрЗаменить(ТекстПоследнегоСообщения, Символы.ПС, " ");
		Если ПустаяСтрока(ТекстПоследнегоСообщения) Тогда
			ТекстПоследнегоСообщения = "Нет сообщений";
		КонецЕсли;

		СтрокаДиалога.ПредставлениеДиалога = Строка(СтрокаДиалога.Пациент)
			+ ИндикаторНепрочитанного + Символы.ПС + ТекстПоследнегоСообщения;
	КонецЦикла;

	СвернутыеДиалоги.Сортировать("ДатаПоследнегоСообщения Убыв, Пациент");
	СвернутыеДиалоги.Колонки.Удалить(СвернутыеДиалоги.Колонки.Входящее);
	ЗначениеВРеквизитФормы(СвернутыеДиалоги, "Пациенты");

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСообщенияНаСервере()

	Если Не ЗначениеЗаполнено(ТекущийПациент) Тогда
		Сообщения.Очистить();
		ЛентаСообщений = Новый ФорматированныйДокумент;
		Возврат;
	КонецЕсли;

	ПометитьВходящиеПрочитаннымиНаСервере();

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	История.Период КАК Период,
				   |	История.Входящее КАК Входящее,
				   |	История.Автор КАК Автор,
				   |	История.Текст КАК Текст,
				   |	История.Статус КАК Статус,
				   |	История.ВидСообщения КАК ВидСообщения
				   |ИЗ
				   |	РегистрСведений.бит_омни_ИсторияЧатовMAX КАК История
				   |ГДЕ
				   |	История.Контакт.Получатель = &Пациент
				   |	И История.Бот = &Бот
				   |
				   |УПОРЯДОЧИТЬ ПО
				   |	Период";

	Запрос.УстановитьПараметр("Пациент", ТекущийПациент);
	Запрос.УстановитьПараметр("Бот", ТекущийБот);

	ТаблицаСообщений = Запрос.Выполнить().Выгрузить();
	ЗначениеВРеквизитФормы(ТаблицаСообщений, "Сообщения");
	СформироватьЛентуСообщенийНаСервере(ТаблицаСообщений);

КонецПроцедуры

&НаСервере
Процедура ПометитьВходящиеПрочитаннымиНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	Контакты.Ссылка КАК Контакт
				   |ИЗ
				   |	Справочник.бит_омни_Контакты КАК Контакты
				   |ГДЕ
				   |	Контакты.Получатель = &Пациент
				   |	И Контакты.Бот = &Бот
				   |	И НЕ Контакты.ПометкаУдаления";
	Запрос.УстановитьПараметр("Пациент", ТекущийПациент);
	Запрос.УстановитьПараметр("Бот", ТекущийБот);

	ВыборкаКонтактов = Запрос.Выполнить().Выбрать();
	Пока ВыборкаКонтактов.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.бит_омни_ИсторияЧатовMAX.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Контакт.Установить(ВыборкаКонтактов.Контакт);
		НаборЗаписей.Отбор.Бот.Установить(ТекущийБот);
		НаборЗаписей.Отбор.Входящее.Установить(Истина);
		НаборЗаписей.Прочитать();

		ЕстьИзменения = Ложь;
		Для Каждого Запись Из НаборЗаписей Цикл
			Если Не Запись.Прочитано Тогда
				Запись.Прочитано = Истина;
				ЕстьИзменения = Истина;
			КонецЕсли;
		КонецЦикла;

		Если ЕстьИзменения Тогда
			НаборЗаписей.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СформироватьЛентуСообщенийНаСервере(ТаблицаСообщений)

	ЛентаСообщений = Новый ФорматированныйДокумент;
	ТекстHTML = "<html><body>";

	Для Каждого Сообщение Из ТаблицаСообщений Цикл
		Если Сообщение.Входящее Тогда
			ВыравниваниеHTML = "left";
			ЦветФонаHTML = "#F5F5F5";
			ЦветЗаголовкаHTML = "#696969";
		Иначе
			ВыравниваниеHTML = "right";
			ЦветФонаHTML = "#DDF5DD";
			ЦветЗаголовкаHTML = "#006400";
		КонецЕсли;

		АвторHTML = ЭкранироватьТекстДляHTML(Сообщение.Автор);
		ДатаHTML = ЭкранироватьТекстДляHTML(Формат(Сообщение.Период, "ДФ=dd.MM.yyyy HH:mm"));
		СообщениеHTML = ЭкранироватьТекстДляHTML(Сообщение.Текст);
		СообщениеHTML = СтрЗаменить(СообщениеHTML, Символы.ВК, "");
		СообщениеHTML = СтрЗаменить(СообщениеHTML, Символы.ПС, "<br/>");

		ТекстHTML = ТекстHTML
			+ "<div align='" + ВыравниваниеHTML + "' style='margin:6px;'>"
			+ "<span style='background-color:" + ЦветФонаHTML + "; padding:6px;'>"
			+ "<b style='color:" + ЦветЗаголовкаHTML + ";'>" + АвторHTML + "  " + ДатаHTML + "</b>"
			+ "<br/>" + СообщениеHTML;

		Если Не Сообщение.Входящее И Не ПустаяСтрока(Сообщение.Статус) Тогда
			СтатусHTML = ЭкранироватьТекстДляHTML(Сообщение.Статус);
			ТекстHTML = ТекстHTML + "<br/><small style='color:#808080;'>" + СтатусHTML + "</small>";
		КонецЕсли;

		ТекстHTML = ТекстHTML + "</span></div>";
	КонецЦикла;

	ТекстHTML = ТекстHTML + "</body></html>";
	ЛентаСообщений.УстановитьHTML(ТекстHTML, Новый Структура);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭкранироватьТекстДляHTML(Значение)

	Результат = Строка(Значение);
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Возврат Результат;

КонецФункции

&НаСервере
Функция ОтправитьОтветНаСервере()

	Попытка
		РезультатОтправки = бит_омни_ИнтеграцияСMAX.ОтправитьТекстовоеСообщение(
			СокрЛП(ТекстОтвета), ТекущийКонтакт, ТекущийБот);

		Успех = Истина;
		ОписаниеОшибки = "";
		Если ТипЗнч(РезультатОтправки) = Тип("Структура") Тогда
			РезультатОтправки.Свойство("success", Успех);
			РезультатОтправки.Свойство("message", ОписаниеОшибки);
		КонецЕсли;

		Если Успех Тогда
			РезультатЗаписи = РезультатПоследнейОтправкиНаСервере();
			Если РезультатЗаписи <> Неопределено И РезультатЗаписи.Статус = "Ошибка" Тогда
				Успех = Ложь;
				ОписаниеОшибки = РезультатЗаписи.ОписаниеОшибки;
			КонецЕсли;
		КонецЕсли;

		Если Не Успех И ПустаяСтрока(ОписаниеОшибки) Тогда
			ОписаниеОшибки = "MAX отклонил сообщение.";
		КонецЕсли;

		Возврат Новый Структура(
			"Успех, ОписаниеОшибки",
			Успех,
			?(Успех, "", ОписаниеОшибки));
	Исключение
		Возврат Новый Структура(
			"Успех, ОписаниеОшибки",
			Ложь,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

&НаСервере
Функция РезультатПоследнейОтправкиНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				   |	История.Статус КАК Статус,
				   |	История.ОписаниеОшибки КАК ОписаниеОшибки
				   |ИЗ
				   |	РегистрСведений.бит_омни_ИсторияЧатовMAX КАК История
				   |ГДЕ
				   |	История.Контакт = &Контакт
				   |	И История.Бот = &Бот
				   |	И НЕ История.Входящее
				   |
				   |УПОРЯДОЧИТЬ ПО
				   |	История.Период УБЫВ";

	Запрос.УстановитьПараметр("Контакт", ТекущийКонтакт);
	Запрос.УстановитьПараметр("Бот", ТекущийБот);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура(
			"Статус, ОписаниеОшибки",
			Выборка.Статус,
			Выборка.ОписаниеОшибки);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Процедура ОбновитьДоступностьОтправки()

	Элементы.ТекстОтвета.Доступность = ЗначениеЗаполнено(ТекущийКонтакт);
	Элементы.ОтправитьКнопка.Доступность = ЗначениеЗаполнено(ТекущийКонтакт);

КонецПроцедуры

#КонецОбласти
